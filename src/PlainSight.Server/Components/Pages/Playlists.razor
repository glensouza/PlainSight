@page "/playlists"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<PlainSightDbContext> DbFactory
@inject ILogger<Playlists> Logger
@inject ScheduleCache ScheduleCache

<PageTitle>Playlists — PlainSight</PageTitle>

<div class="page-header">
    <h1>Playlists</h1>
    <p class="text-muted mb-0">Create and manage content playlists for your digital signage devices</p>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <button class="btn btn-primary" @onclick="ShowCreatePlaylist">
            <i class="bi bi-plus-circle"></i> Create New Playlist
        </button>
    </div>
</div>

@if (showCreateForm)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">@(editingPlaylistId.HasValue ? "Edit" : "Create") Playlist</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" @bind="playlistName" placeholder="My Playlist" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" @bind="playlistDescription" rows="2" placeholder="Optional description"></textarea>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="playlistIsActive" id="isActive" />
                    <label class="form-check-label" for="isActive">
                        Active (available for assignment to devices)
                    </label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Ordering</label>
                <select class="form-select" @bind="playlistSortMode">
                    <option value="@PlaylistSortMode.Manual">Manual (drag to reorder)</option>
                    <option value="@PlaylistSortMode.ByEventDate">Automatic — by event date (soonest first)</option>
                </select>
                <div class="form-text">Automatic ordering sorts items by their event date; items without a date play last.</div>
            </div>
            <button class="btn btn-primary" @onclick="SavePlaylist">
                <i class="bi bi-save"></i> Save Playlist
            </button>
            <button class="btn btn-secondary" @onclick="CancelEdit">
                Cancel
            </button>
        </div>
    </div>
}

@if (playlists == null)
{
    <p><em>Loading playlists...</em></p>
}
else if (!playlists.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No playlists created yet. Create a playlist to organize your content.
    </div>
}
else
{
    <div class="row">
        @foreach (Playlist playlist in playlists)
        {
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            @playlist.Name
                            @if (playlist.IsActive)
                            {
                                <span class="badge bg-success ms-2">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2">Inactive</span>
                            }
                        </h5>
                        <div>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditPlaylist(playlist.Id)">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePlaylist(playlist.Id)">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                            </div>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(playlist.Description))
                        {
                            <p class="text-muted small">@playlist.Description</p>
                        }
                        <div class="mb-2">
                            <strong>Items:</strong> @playlist.Items.Count
                        </div>
                        <small class="text-muted">
                            Created: @playlist.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </small>
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-sm btn-primary" @onclick="() => ManagePlaylistItems(playlist.Id)">
                                <i class="bi bi-list"></i> Manage Content
                            </button>
                            <button class="btn btn-sm btn-outline-info" @onclick="() => PreviewPlaylist(playlist.Id)">
                                <i class="bi bi-play-circle"></i> Preview
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (isPreviewing && selectedPlaylist != null)
{
    <PlaylistPreviewDialog Playlist="selectedPlaylist" OnClose="ClosePreview" />
}

@if (managingPlaylistId.HasValue && selectedPlaylist != null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage Content: @selectedPlaylist.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseManageItems"></button>
                </div>
                <div class="modal-body">

                    <h6>Current Items (@selectedPlaylist.Items.Count)</h6>
                    @if (selectedPlaylist.Items.Count != 0)
                    {
                        <p class="text-muted small mb-1"><i class="bi bi-info-circle"></i> Drag items to reorder.</p>
                        <div class="list-group mb-3">
                            @foreach (PlaylistItem item in selectedPlaylist.Items.OrderBy(i => i.Order))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center @(dragOverItemId == item.Id ? "border-primary border-2" : "") @(draggedItem?.Id == item.Id ? "opacity-50" : "")"
                                     draggable="true"
                                     style="cursor: grab;"
                                     @ondragstart="() => OnDragStart(item)"
                                     @ondragend="OnDragEnd"
                                     @ondragenter="() => OnDragEnter(item)"
                                     @ondragover:preventDefault="true"
                                     @ondrop="() => OnDropAsync(item)">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-grip-vertical me-3 text-muted" style="font-size: 1.2rem;"></i>
                                        <div>
                                            @if (item.Announcement != null)
                                            {
                                                <strong>@item.Order.</strong> @item.Announcement.Title
                                                <span class="badge bg-info ms-2">Announcement · @item.Announcement.Media.Count media</span>
                                            }
                                            else
                                            {
                                                <strong>@item.Order.</strong> @item.ContentItem!.Name
                                                <span class="badge bg-secondary ms-2">@item.ContentItem.DurationSeconds s</span>
                                            }
                                        </div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RemoveFromPlaylist(item.Id)"
                                            disabled="@isReordering">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No items in this playlist yet.</p>
                    }

                    <hr />

                    <h6>Add Content</h6>
                    @if (availableContent == null)
                    {
                        <p><em>Loading available content...</em></p>
                    }
                    else if (availableContent.Count == 0)
                    {
                        <div class="alert alert-warning py-2 small">
                            No content available. Upload content on the <a href="content">Content</a> page first.
                        </div>
                    }
                    else if (AvailableContentFiltered.Count == 0)
                    {
                        <div class="alert alert-info py-2 small">
                            <i class="bi bi-check-circle"></i> All content has been added to this playlist.
                        </div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (ContentItem content in AvailableContentFiltered)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span>@content.Name</span>
                                        <span class="badge bg-secondary ms-2">@content.DurationSeconds s</span>
                                        <span class="badge bg-info ms-1">@content.Type</span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => AddToPlaylist(content.Id)"
                                            disabled="@isAddingItem">
                                        <i class="bi bi-plus"></i> Add
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <h6 class="mt-3">Add Announcement</h6>
                    @if (availableAnnouncements == null)
                    {
                        <p><em>Loading announcements...</em></p>
                    }
                    else if (availableAnnouncements.Count == 0)
                    {
                        <div class="alert alert-warning py-2 small">
                            No announcements available. Create one on the <a href="announcements">Announcements</a> page first.
                        </div>
                    }
                    else if (AvailableAnnouncementsFiltered.Count == 0)
                    {
                        <div class="alert alert-info py-2 small">
                            <i class="bi bi-check-circle"></i> All announcements have been added to this playlist.
                        </div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (Announcement announcement in AvailableAnnouncementsFiltered)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span>@announcement.Title</span>
                                        <span class="badge bg-info ms-1">@announcement.Media.Count media</span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => AddAnnouncementToPlaylist(announcement.Id)"
                                            disabled="@isAddingItem">
                                        <i class="bi bi-plus"></i> Add
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseManageItems">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task<bool> IsAdminAsync()
    {
        if (this.AuthState == null)
        {
            return false;
        }

        AuthenticationState state = await this.AuthState;
        return state.User.IsInRole("Admin");
    }

    private List<Playlist>? playlists;
    private List<ContentItem>? availableContent;
    private List<Announcement>? availableAnnouncements;
    private bool showCreateForm;
    private int? editingPlaylistId;
    private string playlistName = string.Empty;
    private string playlistDescription = string.Empty;
    private bool playlistIsActive = true;
    private PlaylistSortMode playlistSortMode = PlaylistSortMode.Manual;
    private int? managingPlaylistId;
    private Playlist? selectedPlaylist;
    private bool isAddingItem;
    private bool isReordering;
    private bool isPreviewing;
    private PlaylistItem? draggedItem;
    private int? draggedFromPlaylistId;
    private int? dragOverItemId;

    // Cached list of content not already in the open playlist. Recomputed only when the open
    // playlist or the available-content list changes, not on every render.
    private List<ContentItem> availableContentFiltered = [];
    private List<Announcement> availableAnnouncementsFiltered = [];

    private List<ContentItem> AvailableContentFiltered => this.availableContentFiltered;
    private List<Announcement> AvailableAnnouncementsFiltered => this.availableAnnouncementsFiltered;

    private void RecomputeAvailableContentFiltered()
    {
        if (this.availableContent == null || this.selectedPlaylist == null)
        {
            this.availableContentFiltered = [];
        }
        else
        {
            HashSet<int> inPlaylist = this.selectedPlaylist.Items.Where(i => i.ContentItemId.HasValue).Select(i => i.ContentItemId!.Value).ToHashSet();
            this.availableContentFiltered = this.availableContent.Where(c => !inPlaylist.Contains(c.Id)).ToList();
        }

        if (this.availableAnnouncements == null || this.selectedPlaylist == null)
        {
            this.availableAnnouncementsFiltered = [];
        }
        else
        {
            HashSet<int> inPlaylist = this.selectedPlaylist.Items.Where(i => i.AnnouncementId.HasValue).Select(i => i.AnnouncementId!.Value).ToHashSet();
            this.availableAnnouncementsFiltered = this.availableAnnouncements.Where(a => !inPlaylist.Contains(a.Id)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPlaylists();
    }

    private async Task LoadPlaylists()
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            // Cards only need each playlist's item count, so skip the ContentItem join here.
            // The Preview dialog loads the full graph on demand (see PreviewPlaylist).
            playlists = await context.Playlists
                .Include(p => p.Items)
                .OrderByDescending(p => p.UpdatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading playlists");
            playlists = [];
        }
    }

    private async Task LoadAvailableContent()
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            availableContent = await context.ContentItems
                .OrderBy(c => c.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading content items");
            availableContent = [];
        }

        this.RecomputeAvailableContentFiltered();
    }

    private async Task LoadAvailableAnnouncements()
    {
        try
        {
            DateTime utcNow = DateTime.UtcNow;
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            availableAnnouncements = await context.Announcements
                .Include(a => a.Media)
                .Where(a => a.ExpiresAt == null || a.ExpiresAt >= utcNow)
                .OrderBy(a => a.Title)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading announcements");
            availableAnnouncements = [];
        }

        this.RecomputeAvailableContentFiltered();
    }

    private void ShowCreatePlaylist()
    {
        showCreateForm = true;
        editingPlaylistId = null;
        playlistName = string.Empty;
        playlistDescription = string.Empty;
        playlistIsActive = true;
        playlistSortMode = PlaylistSortMode.Manual;
    }

    private void EditPlaylist(int id)
    {
        Playlist? playlist = playlists?.FirstOrDefault(p => p.Id == id);
        if (playlist == null)
        {
            return;
        }

        showCreateForm = true;
        editingPlaylistId = id;
        playlistName = playlist.Name;
        playlistDescription = playlist.Description ?? string.Empty;
        playlistIsActive = playlist.IsActive;
        playlistSortMode = playlist.SortMode;
    }

    private void CancelEdit()
    {
        showCreateForm = false;
        editingPlaylistId = null;
    }

    private async Task SavePlaylist()
    {
        if (string.IsNullOrWhiteSpace(playlistName))
        {
            Logger.LogWarning("Playlist name is required");
            return;
        }

        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            
            if (editingPlaylistId.HasValue)
            {
                Playlist? playlist = await context.Playlists.FindAsync(editingPlaylistId.Value);
                if (playlist != null)
                {
                    playlist.Name = playlistName;
                    playlist.Description = playlistDescription;
                    playlist.IsActive = playlistIsActive;
                    playlist.SortMode = playlistSortMode;
                    playlist.UpdatedAt = DateTime.UtcNow;
                }
            }
            else
            {
                Playlist playlist = new()
                {
                    Name = playlistName,
                    Description = playlistDescription,
                    IsActive = playlistIsActive,
                    SortMode = playlistSortMode,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                context.Playlists.Add(playlist);
            }

            await context.SaveChangesAsync();
            showCreateForm = false;
            editingPlaylistId = null;
            await LoadPlaylists();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving playlist");
        }
    }

    private async Task DeletePlaylist(int id)
    {
        if (!await this.IsAdminAsync())
        {
            this.Logger.LogWarning("Non-admin user attempted to delete playlist {Id}", id);
            return;
        }

        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Playlist? playlist = await context.Playlists.FindAsync(id);
            if (playlist != null)
            {
                context.Playlists.Remove(playlist);
                await context.SaveChangesAsync();
                ScheduleCache.Invalidate();
                await LoadPlaylists();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting playlist");
        }
    }

    private async Task ManagePlaylistItems(int playlistId)
    {
        managingPlaylistId = playlistId;
        availableContent = null;
        availableAnnouncements = null;
        try
        {
            await ReloadSelectedPlaylistAsync(playlistId);
            await LoadAvailableContent();
            await LoadAvailableAnnouncements();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading playlist items");
        }
    }

    // Reloads only the open playlist's items. The available-content list does not
    // change while the modal is open (uploads/deletes happen on the Content page),
    // so add/remove/reorder reuse this instead of reloading everything.
    private async Task ReloadSelectedPlaylistAsync(int playlistId)
    {
        await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
        selectedPlaylist = await context.Playlists
            .Include(p => p.Items)
            .ThenInclude(i => i.ContentItem)
            .Include(p => p.Items)
            .ThenInclude(i => i.Announcement)
            .ThenInclude(a => a!.Media)
            .ThenInclude(m => m.ContentItem)
            .FirstOrDefaultAsync(p => p.Id == playlistId);

        this.RecomputeAvailableContentFiltered();
    }

    private async Task PreviewPlaylist(int playlistId)
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            selectedPlaylist = await context.Playlists
                .Include(p => p.Items)
                .ThenInclude(i => i.ContentItem)
                .Include(p => p.Items)
                .ThenInclude(i => i.Announcement)
                .ThenInclude(a => a!.Media)
                .ThenInclude(m => m.ContentItem)
                .FirstOrDefaultAsync(p => p.Id == playlistId);

            if (selectedPlaylist != null)
            {
                isPreviewing = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading playlist for preview");
        }
    }

    private void ClosePreview()
    {
        isPreviewing = false;
        selectedPlaylist = null;
    }

    private async Task AddToPlaylist(int contentItemId)
    {
        if (!managingPlaylistId.HasValue) return;

        isAddingItem = true;
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Playlist? playlist = await context.Playlists
                .Include(p => p.Items)
                .FirstOrDefaultAsync(p => p.Id == managingPlaylistId.Value);

            if (playlist == null) return;

            int nextOrder = playlist.Items.Count != 0 ? playlist.Items.Max(i => i.Order) + 1 : 1;

            PlaylistItem playlistItem = new()
            {
                PlaylistId = managingPlaylistId.Value,
                ContentItemId = contentItemId,
                Order = nextOrder
            };

            context.PlaylistItems.Add(playlistItem);
            playlist.UpdatedAt = DateTime.UtcNow;
            await context.SaveChangesAsync();
            ScheduleCache.Invalidate();

            await ReloadSelectedPlaylistAsync(managingPlaylistId.Value);
            await LoadPlaylists();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding item to playlist");
        }
        finally
        {
            isAddingItem = false;
        }
    }

    private async Task AddAnnouncementToPlaylist(int announcementId)
    {
        if (!managingPlaylistId.HasValue)
        {
            return;
        }

        isAddingItem = true;
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Playlist? playlist = await context.Playlists
                .Include(p => p.Items)
                .FirstOrDefaultAsync(p => p.Id == managingPlaylistId.Value);

            if (playlist == null)
            {
                return;
            }

            int nextOrder = playlist.Items.Count != 0 ? playlist.Items.Max(i => i.Order) + 1 : 1;

            PlaylistItem playlistItem = new()
            {
                PlaylistId = managingPlaylistId.Value,
                AnnouncementId = announcementId,
                Order = nextOrder
            };

            context.PlaylistItems.Add(playlistItem);
            playlist.UpdatedAt = DateTime.UtcNow;
            await context.SaveChangesAsync();
            ScheduleCache.Invalidate();

            await ReloadSelectedPlaylistAsync(managingPlaylistId.Value);
            await LoadPlaylists();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding announcement to playlist");
        }
        finally
        {
            isAddingItem = false;
        }
    }

    private void OnDragStart(PlaylistItem item)
    {
        this.draggedItem = item;
        this.draggedFromPlaylistId = this.managingPlaylistId;
    }

    private void OnDragEnter(PlaylistItem item)
    {
        if (this.draggedItem != null && this.draggedItem.Id != item.Id)
        {
            this.dragOverItemId = item.Id;
        }
    }

    private void OnDragEnd()
    {
        this.draggedItem = null;
        this.draggedFromPlaylistId = null;
        this.dragOverItemId = null;
    }

    private async Task OnDropAsync(PlaylistItem target)
    {
        PlaylistItem? dragged = this.draggedItem;
        int? draggedFrom = this.draggedFromPlaylistId;
        this.draggedItem = null;
        this.draggedFromPlaylistId = null;
        this.dragOverItemId = null;

        // Ignore the drop if the modal was closed or switched to a different playlist mid-drag.
        if (dragged == null || dragged.Id == target.Id || selectedPlaylist == null || !managingPlaylistId.HasValue || isReordering || draggedFrom != managingPlaylistId)
        {
            return;
        }

        int playlistId = managingPlaylistId.Value;
        List<PlaylistItem> items = selectedPlaylist.Items.OrderBy(i => i.Order).ToList();
        int fromIndex = items.FindIndex(i => i.Id == dragged.Id);
        int toIndex = items.FindIndex(i => i.Id == target.Id);

        if (fromIndex == -1 || toIndex == -1)
        {
            return;
        }

        isReordering = true;
        try
        {
            PlaylistItem itemToMove = items[fromIndex];
            items.RemoveAt(fromIndex);
            items.Insert(toIndex, itemToMove);

            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            List<PlaylistItem> dbItems = await context.PlaylistItems
                .Where(i => i.PlaylistId == playlistId)
                .ToListAsync();

            Dictionary<int, PlaylistItem> itemMap = dbItems.ToDictionary(i => i.Id);

            for (int i = 0; i < items.Count; i++)
            {
                if (itemMap.TryGetValue(items[i].Id, out PlaylistItem? dbItem))
                {
                    dbItem.Order = i + 1;
                }
            }

            Playlist? playlist = await context.Playlists.FindAsync(playlistId);
            playlist?.UpdatedAt = DateTime.UtcNow;

            await context.SaveChangesAsync();
            ScheduleCache.Invalidate();

            await ReloadSelectedPlaylistAsync(playlistId);
            await LoadPlaylists();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reordering items");
        }
        finally
        {
            isReordering = false;
        }
    }

    private void CloseManageItems()
    {
        managingPlaylistId = null;
        selectedPlaylist = null;
        availableContent = null;
        availableAnnouncements = null;
        this.availableContentFiltered = [];
        this.availableAnnouncementsFiltered = [];
    }

    private async Task RemoveFromPlaylist(int playlistItemId)
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            PlaylistItem? item = await context.PlaylistItems
                .Include(i => i.Playlist)
                .FirstOrDefaultAsync(i => i.Id == playlistItemId);

            if (item != null)
            {
                int playlistId = item.PlaylistId;
                context.PlaylistItems.Remove(item);
                item.Playlist.UpdatedAt = DateTime.UtcNow;
                await context.SaveChangesAsync();
                ScheduleCache.Invalidate();

                await ReloadSelectedPlaylistAsync(playlistId);
                await LoadPlaylists();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing item from playlist");
        }
    }
}
