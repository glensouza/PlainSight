@page "/playlists"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<PlainSightDbContext> DbFactory
@inject NavigationManager Navigation
@inject ILogger<Playlists> Logger
@using Microsoft.EntityFrameworkCore
@using PlainSight.Shared.Models
@using PlainSight.Server.Data

<PageTitle>Playlists — PlainSight</PageTitle>

<div class="page-header">
    <h1>Playlists</h1>
    <p class="text-muted mb-0">Create and manage content playlists for your digital signage devices</p>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <button class="btn btn-primary" @onclick="ShowCreatePlaylist">
            <i class="bi bi-plus-circle"></i> Create New Playlist
        </button>
    </div>
</div>

@if (showCreateForm)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">@(editingPlaylistId.HasValue ? "Edit" : "Create") Playlist</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" @bind="playlistName" placeholder="My Playlist" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" @bind="playlistDescription" rows="2" placeholder="Optional description"></textarea>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="playlistIsActive" id="isActive" />
                    <label class="form-check-label" for="isActive">
                        Active (available for assignment to devices)
                    </label>
                </div>
            </div>
            <button class="btn btn-primary" @onclick="SavePlaylist">
                <i class="bi bi-save"></i> Save Playlist
            </button>
            <button class="btn btn-secondary" @onclick="CancelEdit">
                Cancel
            </button>
        </div>
    </div>
}

@if (playlists == null)
{
    <p><em>Loading playlists...</em></p>
}
else if (!playlists.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No playlists created yet. Create a playlist to organize your content.
    </div>
}
else
{
    <div class="row">
        @foreach (Playlist playlist in playlists)
        {
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            @playlist.Name
                            @if (playlist.IsActive)
                            {
                                <span class="badge bg-success ms-2">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2">Inactive</span>
                            }
                        </h5>
                        <div>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditPlaylist(playlist.Id)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePlaylist(playlist.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(playlist.Description))
                        {
                            <p class="text-muted small">@playlist.Description</p>
                        }
                        <div class="mb-2">
                            <strong>Items:</strong> @playlist.Items.Count
                        </div>
                        <small class="text-muted">
                            Created: @playlist.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </small>
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-sm btn-primary" @onclick="() => ManagePlaylistItems(playlist.Id)">
                                <i class="bi bi-list"></i> Manage Content
                            </button>
                            <button class="btn btn-sm btn-outline-info" @onclick="() => PreviewPlaylist(playlist.Id)">
                                <i class="bi bi-play-circle"></i> Preview
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (isPreviewing && selectedPlaylist != null)
{
    <PlaylistPreviewDialog Playlist="selectedPlaylist" OnClose="ClosePreview" />
}

@if (managingPlaylistId.HasValue && selectedPlaylist != null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage Content: @selectedPlaylist.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseManageItems"></button>
                </div>
                <div class="modal-body">

                    <h6>Current Items (@selectedPlaylist.Items.Count)</h6>
                    @if (selectedPlaylist.Items.Any())
                    {
                        <div class="list-group mb-3">
                            @{
                                List<PlaylistItem> orderedItems = selectedPlaylist.Items.OrderBy(i => i.Order).ToList();
                            }
                            @foreach (PlaylistItem item in orderedItems)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <div class="d-flex flex-column me-3">
                                            <button class="btn btn-sm btn-light mb-1 border" 
                                                    style="padding: 4px 8px; line-height: 1; min-width: 32px;"
                                                    @onclick="() => MoveItem(item, -1)" 
                                                    disabled="@(item.Id == orderedItems.First().Id || isReordering)"
                                                    title="Move Up">
                                                <i class="bi bi-caret-up-fill" style="font-size: 1.2rem;"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light border" 
                                                    style="padding: 4px 8px; line-height: 1; min-width: 32px;"
                                                    @onclick="() => MoveItem(item, 1)" 
                                                    disabled="@(item.Id == orderedItems.Last().Id || isReordering)"
                                                    title="Move Down">
                                                <i class="bi bi-caret-down-fill" style="font-size: 1.2rem;"></i>
                                            </button>
                                        </div>
                                        <div>
                                            <strong>@item.Order.</strong> @item.ContentItem.Name
                                            <span class="badge bg-secondary ms-2">@item.ContentItem.DurationSeconds s</span>
                                        </div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger" 
                                            @onclick="() => RemoveFromPlaylist(item.Id)"
                                            disabled="@isReordering">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No items in this playlist yet.</p>
                    }

                    <hr />

                    <h6>Add Content</h6>
                    @if (availableContent == null)
                    {
                        <p><em>Loading available content...</em></p>
                    }
                    else if (!availableContent.Any())
                    {
                        <div class="alert alert-warning py-2 small">
                            No content available. Upload content on the <a href="content">Content</a> page first.
                        </div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (ContentItem content in availableContent)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span>@content.Name</span>
                                        <span class="badge bg-secondary ms-2">@content.DurationSeconds s</span>
                                        <span class="badge bg-info ms-1">@content.Type</span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => AddToPlaylist(content.Id)"
                                            disabled="@isAddingItem">
                                        <i class="bi bi-plus"></i> Add
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseManageItems">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Playlist>? playlists;
    private List<ContentItem>? availableContent;
    private bool showCreateForm;
    private int? editingPlaylistId;
    private string playlistName = string.Empty;
    private string playlistDescription = string.Empty;
    private bool playlistIsActive = true;
    private int? managingPlaylistId;
    private Playlist? selectedPlaylist;
    private bool isAddingItem;
    private bool isReordering;
    private bool isPreviewing;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlaylists();
    }

    private async Task LoadPlaylists()
    {
        try
        {
            using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            playlists = await context.Playlists
                .Include(p => p.Items)
                .ThenInclude(i => i.ContentItem)
                .OrderByDescending(p => p.UpdatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading playlists");
            playlists = new List<Playlist>();
        }
    }

    private async Task LoadAvailableContent()
    {
        try
        {
            using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            availableContent = await context.ContentItems
                .OrderByDescending(c => c.UploadedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading content items");
            availableContent = new List<ContentItem>();
        }
    }

    private void ShowCreatePlaylist()
    {
        showCreateForm = true;
        editingPlaylistId = null;
        playlistName = string.Empty;
        playlistDescription = string.Empty;
        playlistIsActive = true;
    }

    private void EditPlaylist(int id)
    {
        Playlist? playlist = playlists?.FirstOrDefault(p => p.Id == id);
        if (playlist != null)
        {
            showCreateForm = true;
            editingPlaylistId = id;
            playlistName = playlist.Name;
            playlistDescription = playlist.Description ?? string.Empty;
            playlistIsActive = playlist.IsActive;
        }
    }

    private void CancelEdit()
    {
        showCreateForm = false;
        editingPlaylistId = null;
    }

    private async Task SavePlaylist()
    {
        if (string.IsNullOrWhiteSpace(playlistName))
        {
            Logger.LogWarning("Playlist name is required");
            return;
        }

        try
        {
            using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            
            if (editingPlaylistId.HasValue)
            {
                Playlist? playlist = await context.Playlists.FindAsync(editingPlaylistId.Value);
                if (playlist != null)
                {
                    playlist.Name = playlistName;
                    playlist.Description = playlistDescription;
                    playlist.IsActive = playlistIsActive;
                    playlist.UpdatedAt = DateTime.UtcNow;
                }
            }
            else
            {
                Playlist playlist = new()
                {
                    Name = playlistName,
                    Description = playlistDescription,
                    IsActive = playlistIsActive,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                context.Playlists.Add(playlist);
            }

            await context.SaveChangesAsync();
            showCreateForm = false;
            editingPlaylistId = null;
            await LoadPlaylists();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving playlist");
        }
    }

    private async Task DeletePlaylist(int id)
    {
        try
        {
            using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Playlist? playlist = await context.Playlists.FindAsync(id);
            if (playlist != null)
            {
                context.Playlists.Remove(playlist);
                await context.SaveChangesAsync();
                await LoadPlaylists();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting playlist");
        }
    }

    private async Task ManagePlaylistItems(int playlistId)
    {
        managingPlaylistId = playlistId;
        availableContent = null;
        try
        {
            using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            selectedPlaylist = await context.Playlists
                .Include(p => p.Items)
                .ThenInclude(i => i.ContentItem)
                .FirstOrDefaultAsync(p => p.Id == playlistId);
            
            await LoadAvailableContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading playlist items");
        }
    }

    private void PreviewPlaylist(int playlistId)
    {
        selectedPlaylist = playlists?.FirstOrDefault(p => p.Id == playlistId);
        if (selectedPlaylist != null)
        {
            isPreviewing = true;
        }
    }

    private void ClosePreview()
    {
        isPreviewing = false;
        selectedPlaylist = null;
    }

    private async Task AddToPlaylist(int contentItemId)
    {
        if (!managingPlaylistId.HasValue) return;

        isAddingItem = true;
        try
        {
            using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Playlist? playlist = await context.Playlists
                .Include(p => p.Items)
                .FirstOrDefaultAsync(p => p.Id == managingPlaylistId.Value);

            if (playlist == null) return;

            int nextOrder = playlist.Items.Any() ? playlist.Items.Max(i => i.Order) + 1 : 1;

            PlaylistItem playlistItem = new()
            {
                PlaylistId = managingPlaylistId.Value,
                ContentItemId = contentItemId,
                Order = nextOrder
            };

            context.PlaylistItems.Add(playlistItem);
            playlist.UpdatedAt = DateTime.UtcNow;
            await context.SaveChangesAsync();
            
            await ManagePlaylistItems(managingPlaylistId.Value);
            await LoadPlaylists();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding item to playlist");
        }
        finally
        {
            isAddingItem = false;
        }
    }

    private async Task MoveItem(PlaylistItem item, int direction)
    {
        if (selectedPlaylist == null || !managingPlaylistId.HasValue || isReordering) return;
        int playlistId = managingPlaylistId.Value;

        List<PlaylistItem> items = selectedPlaylist.Items.OrderBy(i => i.Order).ToList();
        int index = items.FindIndex(i => i.Id == item.Id);

        if (index == -1) return;

        int newIndex = index + direction;
        if (newIndex >= 0 && newIndex < items.Count)
        {
            isReordering = true;
            try
            {
                PlaylistItem itemToMove = items[index];
                items.RemoveAt(index);
                items.Insert(newIndex, itemToMove);

                using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
                List<PlaylistItem> dbItems = await context.PlaylistItems
                    .Where(i => i.PlaylistId == playlistId)
                    .ToListAsync();

                Dictionary<int, PlaylistItem> itemMap = dbItems.ToDictionary(i => i.Id);

                for (int i = 0; i < items.Count; i++)
                {
                    if (itemMap.TryGetValue(items[i].Id, out PlaylistItem? dbItem))
                    {
                        dbItem.Order = i + 1;
                    }
                }

                Playlist? playlist = await context.Playlists.FindAsync(playlistId);
                if (playlist != null) playlist.UpdatedAt = DateTime.UtcNow;

                await context.SaveChangesAsync();

                await ManagePlaylistItems(playlistId);
                await LoadPlaylists();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error reordering items");
            }
            finally
            {
                isReordering = false;
            }
        }
    }

    private void CloseManageItems()
    {
        managingPlaylistId = null;
        selectedPlaylist = null;
        availableContent = null;
    }

    private async Task RemoveFromPlaylist(int playlistItemId)
    {
        try
        {
            using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            PlaylistItem? item = await context.PlaylistItems
                .Include(i => i.Playlist)
                .FirstOrDefaultAsync(i => i.Id == playlistItemId);

            if (item != null)
            {
                int playlistId = item.PlaylistId;
                context.PlaylistItems.Remove(item);
                item.Playlist.UpdatedAt = DateTime.UtcNow;
                await context.SaveChangesAsync();
                
                await ManagePlaylistItems(playlistId);
                await LoadPlaylists();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing item from playlist");
        }
    }
}
