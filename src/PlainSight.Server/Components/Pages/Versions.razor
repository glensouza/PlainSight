@page "/versions"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<PlainSightDbContext> DbFactory
@inject IConfiguration Configuration
@inject ILogger<Versions> Logger
@inject Services.Versioning.IPlayerVersionReconciler Reconciler
@implements IDisposable

<PageTitle>Versions — PlainSight</PageTitle>

<div class="page-header">
    <h1>Version Management</h1>
    <p class="text-muted mb-0">Manage player software versions and canary deployments</p>
</div>

@if (loadError != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @loadError</div>
}
@if (syncMessage != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> @syncMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-box-seam"></i> Available Versions</h5>
                <button class="btn btn-sm btn-primary" @onclick="SyncNow" disabled="@syncing">
                    @if (syncing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Syncing...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat me-1"></i>
                        <span>Sync now</span>
                    }
                </button>
            </div>
            <div class="card-body">
                @if (versions == null)
                {
                    <p><em>Loading...</em></p>
                }
                else if (versions.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> No versions uploaded yet.
                    </div>
                }
                else
                {
                    <div class="list-group mb-0">
                        @foreach (PlayerVersion v in versions)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1"><code>@v.VersionNumber</code></h6>
                                        <small class="text-muted">
                                            @v.UploadedAt.ToLocalString("yyyy-MM-dd HH:mm")
                                            &middot; @FormatBytes(v.FileSizeBytes)
                                            @if (!string.IsNullOrEmpty(v.Sha256Hash))
                                            {
                                                <span>&middot; <code title="@v.Sha256Hash">@v.Sha256Hash[..Math.Min(12, v.Sha256Hash.Length)]</code></span>
                                            }
                                        </small>
                                        @if (!string.IsNullOrWhiteSpace(v.Notes))
                                        {
                                            <div><small class="text-secondary">@v.Notes</small></div>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteVersion(v.Id)"
                                            disabled="@deletingId.HasValue">
                                        @if (deletingId == v.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-trash"></i>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Group Version Assignments</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">Assign versions to device groups for canary deployments. Unassigned groups fall back to "Default".</p>

                @if (groups == null)
                {
                    <p><em>Loading...</em></p>
                }
                else
                {
                    @foreach (DeviceGroupVersion g in groups)
                    {
                        <div class="card mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">@g.GroupName</h6>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteGroup(g.GroupName)"
                                            disabled="@(g.GroupName == "Default")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <div class="mt-1">
                                    <label class="small text-muted mb-0">Target Version</label>
                                    <select class="form-select form-select-sm"
                                            value="@g.TargetVersion"
                                            @onchange="e => SaveGroupVersion(g.GroupName, e.Value?.ToString() ?? g.TargetVersion)"
                                            disabled="@(versions == null)">
                                        @if (versions != null)
                                        {
                                            @* Always show the current assignment even if that binary isn't uploaded yet *@
                                            @if (versions.All(v => v.VersionNumber != g.TargetVersion))
                                            {
                                                <option value="@g.TargetVersion">@g.TargetVersion (Missing)</option>
                                            }
                                            @foreach (PlayerVersion v in versions)
                                            {
                                                <option value="@v.VersionNumber">@v.VersionNumber</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="input-group input-group-sm mt-3">
                        <input class="form-control" placeholder="New group name" @bind="newGroupName" />
                        <button class="btn btn-outline-primary"
                                @onclick="AddGroup"
                                disabled="@(string.IsNullOrWhiteSpace(newGroupName) || groups == null)">
                            <i class="bi bi-plus-circle"></i> Add
                        </button>
                    </div>
                    @if (groupError != null)
                    {
                        <div class="alert alert-danger py-1 mt-2 small">@groupError</div>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Canary Deployment Workflow</h5>
            </div>
            <div class="card-body">
                <ol class="small mb-0">
                    <li>Push a <code>v*</code> tag &rarr; CI builds, signs the manifest, drops binary + manifest on the share.</li>
                    <li>Server reconciles within 60 s (or click <strong>Sync now</strong>).</li>
                    <li>Assign the new version to a small test group.</li>
                    <li>Monitor; use Screenshot to verify.</li>
                    <li>Assign to "Default" &rarr; all unassigned groups follow.</li>
                    <li>Devices auto-update within 30&ndash;60 s via heartbeat.</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@code {
    private List<PlayerVersion>? versions;
    private List<DeviceGroupVersion>? groups;

    private string? newGroupName;
    private string? groupError;
    private int? deletingId;
    private string? loadError;
    private string? syncMessage;
    private bool syncing;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            versions = await context.PlayerVersions
                .OrderByDescending(v => v.UploadedAt)
                .ToListAsync();
            
            groups = await context.DeviceGroupVersions
                .OrderBy(g => g.GroupName)
                .ToListAsync();

            loadError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading versions page data");
            loadError = "Failed to load data from server.";
        }
    }

    private async Task SyncNow()
    {
        syncing = true;
        syncMessage = null;
        loadError = null;
        
        try
        {
            int ingested = await this.Reconciler.ReconcileAsync(CancellationToken.None);
            this.syncMessage = ingested > 0 ? $"Sync complete — {ingested} new version(s) ingested." : "Sync complete.";
            await this.LoadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error syncing versions");
            loadError = "Sync failed — check logs for details.";
        }
        finally
        {
            syncing = false;
        }
    }

    private async Task DeleteVersion(int id)
    {
        this.deletingId = id;
        this.loadError = null;
        this.syncMessage = null;
        try
        {
            await using PlainSightDbContext context = await this.DbFactory.CreateDbContextAsync();
            PlayerVersion? version = await context.PlayerVersions.FindAsync(id);
            if (version == null)
            {
                return;
            }

            string updatesPath = this.Configuration["UpdatesPath"] ?? "/mnt/plainsight/updates";
            string safeFileName = Path.GetFileName(version.FileName);
            string filePath = Path.Combine(updatesPath, safeFileName);
            bool binaryExists = File.Exists(filePath);

            if (binaryExists)
            {
                // Only block deletion if the binary is still on disk — once it's gone, cleaning the DB record is safe.
                bool inUse = await context.DeviceGroupVersions.AnyAsync(g => g.TargetVersion == version.VersionNumber);
                if (inUse)
                {
                    this.loadError = $"Version {version.VersionNumber} is still assigned to one or more groups. Reassign those groups first, then delete.";
                    return;
                }

                File.Delete(filePath);
            }

            string manifestPath = Path.Combine(updatesPath, safeFileName + ".json");
            if (File.Exists(manifestPath))
            {
                File.Delete(manifestPath);
            }

            context.PlayerVersions.Remove(version);
            await context.SaveChangesAsync();
            await this.LoadAll();
        }
        catch (Exception ex)
        {
            this.Logger.LogError(ex, "Error deleting version {Id}", id);
            this.loadError = "Delete failed — see logs for details.";
        }
        finally
        {
            this.deletingId = null;
        }
    }

    private async Task SaveGroupVersion(string groupName, string targetVersion)
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();

            bool anyBinariesExist = await context.PlayerVersions.AnyAsync();
            if (anyBinariesExist)
            {
                bool versionExists = await context.PlayerVersions.AnyAsync(v => v.VersionNumber == targetVersion);
                if (!versionExists)
                {
                    groupError = $"Version {targetVersion} does not exist";
                    return;
                }
            }

            DeviceGroupVersion? existing = await context.DeviceGroupVersions
                .FirstOrDefaultAsync(g => g.GroupName == groupName);

            if (existing == null)
            {
                existing = new DeviceGroupVersion { GroupName = groupName };
                context.DeviceGroupVersions.Add(existing);

                bool deviceGroupExists = await context.DeviceGroups.AnyAsync(g => g.Name == groupName);
                if (!deviceGroupExists)
                {
                    context.DeviceGroups.Add(new DeviceGroup { Name = groupName });
                }
            }

            existing.TargetVersion = targetVersion;
            await context.SaveChangesAsync();
            groupError = null;
            await LoadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving group version for {Group}", groupName);
            groupError = "Save failed — check server logs.";
        }
    }

    private async Task AddGroup()
    {
        if (string.IsNullOrWhiteSpace(newGroupName) || groups == null)
        {
            return;
        }


        string defaultVersion = groups.FirstOrDefault(g => g.GroupName == "Default")?.TargetVersion
                               ?? versions?.FirstOrDefault()?.VersionNumber
                               ?? "1.0.0";

        await SaveGroupVersion(newGroupName.Trim(), defaultVersion);
        newGroupName = null;
    }

    private async Task DeleteGroup(string groupName)
    {
        if (groupName == "Default")
        {
            return;
        }


        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            DeviceGroupVersion? existing = await context.DeviceGroupVersions
                .FirstOrDefaultAsync(g => g.GroupName == groupName);

            if (existing != null)
            {
                context.DeviceGroupVersions.Remove(existing);
                
                DeviceGroup? deviceGroup = await context.DeviceGroups
                    .FirstOrDefaultAsync(g => g.Name == groupName);
                if (deviceGroup != null)
                {
                    context.DeviceGroups.Remove(deviceGroup);
                }

                await context.SaveChangesAsync();
                await LoadAll();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting group {Group}", groupName);
            groupError = "Delete failed.";
        }
    }

    private static string FormatBytes(long bytes)
    {
        return bytes switch
        {
            >= 1024 * 1024 => $"{bytes / 1024.0 / 1024.0:F1} MB",
            >= 1024 => $"{bytes / 1024.0:F1} KB",
            _ => $"{bytes} B"
        };
    }

    public void Dispose()
    {
    }
}
