@page "/versions"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<PlainSightDbContext> DbFactory
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ILogger<Versions> Logger
@using Microsoft.EntityFrameworkCore
@using PlainSight.Shared.Models
@using PlainSight.Server.Data
@implements IDisposable

<PageTitle>Versions — PlainSight</PageTitle>

<div class="page-header">
    <h1>Version Management</h1>
    <p class="text-muted mb-0">Manage player software versions and canary deployments</p>
</div>

@if (loadError != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @loadError</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-box-seam"></i> Available Versions</h5>
            </div>
            <div class="card-body">
                @if (versions == null)
                {
                    <p><em>Loading...</em></p>
                }
                else if (versions.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> No versions uploaded yet.
                    </div>
                }
                else
                {
                    <div class="list-group mb-0">
                        @foreach (PlayerVersion v in versions)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1"><code>@v.VersionNumber</code></h6>
                                        <small class="text-muted">
                                            @v.UploadedAt.ToString("yyyy-MM-dd HH:mm") UTC
                                            &middot; @FormatBytes(v.FileSizeBytes)
                                        </small>
                                        @if (!string.IsNullOrWhiteSpace(v.Notes))
                                        {
                                            <div><small class="text-secondary">@v.Notes</small></div>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteVersion(v.Id)"
                                            disabled="@deletingId.HasValue">
                                        @if (deletingId == v.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-trash"></i>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-upload"></i> Upload New Version</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Version Number</label>
                    <input class="form-control" placeholder="e.g. 1.2.0" @bind="uploadVersion" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Binary (linux-arm64 self-contained)</label>
                    <InputFile OnChange="OnFileSelected" class="form-control" accept="*" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Release notes <span class="text-muted">(optional)</span></label>
                    <input class="form-control" placeholder="What changed?" @bind="uploadNotes" />
                </div>
                @if (uploading)
                {
                    <div class="progress mb-3" style="height: 10px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
                    </div>
                }
                @if (uploadError != null)
                {
                    <div class="alert alert-danger py-2">@uploadError</div>
                }
                <button class="btn btn-primary"
                        @onclick="UploadVersion"
                        disabled="@(uploading || selectedFile == null || string.IsNullOrWhiteSpace(uploadVersion))">
                    @if (uploading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Uploading...</span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-upload me-1"></i>
                        <span>Upload</span>
                    }
                </button>
                <small class="text-muted ms-2">
                    Build with: <code>dotnet publish -r linux-arm64 --self-contained -p:PublishSingleFile=true</code>
                </small>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Group Version Assignments</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">Assign versions to device groups for canary deployments. Unassigned groups fall back to "Default".</p>

                @if (groups == null)
                {
                    <p><em>Loading...</em></p>
                }
                else
                {
                    @foreach (DeviceGroupVersion g in groups)
                    {
                        <div class="card mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">@g.GroupName</h6>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteGroup(g.GroupName)"
                                            disabled="@(g.GroupName == "Default")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <div class="mt-1">
                                    <select class="form-select form-select-sm"
                                            @onchange="e => SaveGroupVersion(g.GroupName, e.Value?.ToString() ?? g.TargetVersion)"
                                            disabled="@(versions == null || versions.Count == 0)">
                                        @if (versions != null)
                                        {
                                            @* Always show the current assignment even if that binary isn't uploaded yet *@
                                            @if (!versions.Any(v => v.VersionNumber == g.TargetVersion))
                                            {
                                                <option value="@g.TargetVersion" selected>@g.TargetVersion</option>
                                            }
                                            @foreach (PlayerVersion v in versions)
                                            {
                                                <option value="@v.VersionNumber" selected="@(v.VersionNumber == g.TargetVersion)">@v.VersionNumber</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="input-group input-group-sm mt-3">
                        <input class="form-control" placeholder="New group name" @bind="newGroupName" />
                        <button class="btn btn-outline-primary"
                                @onclick="AddGroup"
                                disabled="@(string.IsNullOrWhiteSpace(newGroupName) || groups == null)">
                            <i class="bi bi-plus-circle"></i> Add
                        </button>
                    </div>
                    @if (groupError != null)
                    {
                        <div class="alert alert-danger py-1 mt-2 small">@groupError</div>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Canary Deployment Workflow</h5>
            </div>
            <div class="card-body">
                <ol class="small mb-0">
                    <li>Upload the new player binary above</li>
                    <li>Assign the new version to a small test group (e.g. "Lab")</li>
                    <li>Monitor those devices via the Device Dashboard</li>
                    <li>Use Screenshot to verify correct operation</li>
                    <li>Assign the version to "Default" — all unassigned groups follow</li>
                    <li>Devices auto-update within 30–60 seconds via heartbeat</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@code {
    private List<PlayerVersion>? versions;
    private List<DeviceGroupVersion>? groups;

    private string uploadVersion = string.Empty;
    private string? uploadNotes;
    private IBrowserFile? selectedFile;
    private bool uploading;
    private string? uploadError;

    private string? newGroupName;
    private string? groupError;
    private int? deletingId;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            versions = await context.PlayerVersions
                .OrderByDescending(v => v.UploadedAt)
                .ToListAsync();
            
            groups = await context.DeviceGroupVersions
                .OrderBy(g => g.GroupName)
                .ToListAsync();
                
            loadError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading versions page data");
            loadError = "Failed to load data from server.";
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadVersion()
    {
        if (selectedFile == null || string.IsNullOrWhiteSpace(uploadVersion)) return;

        uploading = true;
        uploadError = null;
        string? destPath = null;
        try
        {
            string versionNumber = uploadVersion.Trim();
            
            using var context = await DbFactory.CreateDbContextAsync();
            bool exists = await context.PlayerVersions.AnyAsync(v => v.VersionNumber == versionNumber);
            if (exists)
            {
                uploadError = $"Version {versionNumber} already exists";
                return;
            }

            string updatesPath = Configuration["UpdatesPath"] ?? "/mnt/plainsight/updates";
            Directory.CreateDirectory(updatesPath);

            string safeFileName = $"plainsight-player-{versionNumber}";
            destPath = Path.Combine(updatesPath, safeFileName);

            if (File.Exists(destPath))
            {
                uploadError = "Binary file already exists on disk";
                return;
            }

            using (var stream = selectedFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024))
            using (var fs = new FileStream(destPath, FileMode.CreateNew))
            {
                await stream.CopyToAsync(fs);
            }

            PlayerVersion version = new()
            {
                VersionNumber = versionNumber,
                FileName = safeFileName,
                FileSizeBytes = selectedFile.Size,
                UploadedAt = DateTime.UtcNow,
                Notes = uploadNotes
            };
            
            context.PlayerVersions.Add(version);
            await context.SaveChangesAsync();

            uploadVersion = string.Empty;
            uploadNotes = null;
            selectedFile = null;
            await LoadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading version");
            uploadError = "Upload failed — check logs for details.";
            if (destPath != null && File.Exists(destPath))
                File.Delete(destPath);
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task DeleteVersion(int id)
    {
        deletingId = id;
        loadError = null;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            PlayerVersion? version = await context.PlayerVersions.FindAsync(id);
            if (version == null) return;

            // Check if any group is still using this version
            bool inUse = await context.DeviceGroupVersions.AnyAsync(g => g.TargetVersion == version.VersionNumber);
            if (inUse)
            {
                loadError = $"Version {version.VersionNumber} is still assigned to one or more groups";
                return;
            }

            string updatesPath = Configuration["UpdatesPath"] ?? "/mnt/plainsight/updates";
            string filePath = Path.Combine(updatesPath, version.FileName);
            if (File.Exists(filePath))
                File.Delete(filePath);

            context.PlayerVersions.Remove(version);
            await context.SaveChangesAsync();
            await LoadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting version {Id}", id);
            loadError = "Delete failed — see logs for details.";
        }
        finally
        {
            deletingId = null;
        }
    }

    private async Task SaveGroupVersion(string groupName, string targetVersion)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            
            bool anyBinariesExist = await context.PlayerVersions.AnyAsync();
            if (anyBinariesExist)
            {
                bool versionExists = await context.PlayerVersions.AnyAsync(v => v.VersionNumber == targetVersion);
                if (!versionExists)
                {
                    groupError = $"Version {targetVersion} does not exist";
                    return;
                }
            }

            DeviceGroupVersion? existing = await context.DeviceGroupVersions
                .FirstOrDefaultAsync(g => g.GroupName == groupName);

            if (existing == null)
            {
                existing = new DeviceGroupVersion { GroupName = groupName };
                context.DeviceGroupVersions.Add(existing);

                bool deviceGroupExists = await context.DeviceGroups.AnyAsync(g => g.Name == groupName);
                if (!deviceGroupExists)
                    context.DeviceGroups.Add(new DeviceGroup { Name = groupName });
            }

            existing.TargetVersion = targetVersion;
            await context.SaveChangesAsync();
            groupError = null;
            await LoadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving group version for {Group}", groupName);
            groupError = "Save failed — check server logs.";
        }
    }

    private async Task AddGroup()
    {
        if (string.IsNullOrWhiteSpace(newGroupName) || groups == null) return;

        string defaultVersion = groups.FirstOrDefault(g => g.GroupName == "Default")?.TargetVersion
                               ?? versions?.FirstOrDefault()?.VersionNumber
                               ?? "1.0.0";
        
        await SaveGroupVersion(newGroupName.Trim(), defaultVersion);
        newGroupName = null;
    }

    private async Task DeleteGroup(string groupName)
    {
        if (groupName == "Default") return;
        
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            DeviceGroupVersion? existing = await context.DeviceGroupVersions
                .FirstOrDefaultAsync(g => g.GroupName == groupName);

            if (existing != null)
            {
                context.DeviceGroupVersions.Remove(existing);
                
                DeviceGroup? deviceGroup = await context.DeviceGroups
                    .FirstOrDefaultAsync(g => g.Name == groupName);
                if (deviceGroup != null)
                    context.DeviceGroups.Remove(deviceGroup);

                await context.SaveChangesAsync();
                await LoadAll();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting group {Group}", groupName);
            groupError = "Delete failed.";
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024.0 / 1024.0:F1} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024.0:F1} KB";
        return $"{bytes} B";
    }

    public void Dispose()
    {
    }
}
