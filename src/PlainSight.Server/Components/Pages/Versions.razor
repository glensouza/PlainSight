@page "/versions"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ILogger<Versions> Logger
@using PlainSight.Shared.Models
@implements IDisposable

<PageTitle>Versions — PlainSight</PageTitle>

<div class="page-header">
    <h1>Version Management</h1>
    <p class="text-muted mb-0">Manage player software versions and canary deployments</p>
</div>

@if (loadError != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @loadError</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-box-seam"></i> Available Versions</h5>
            </div>
            <div class="card-body">
                @if (versions == null)
                {
                    <p><em>Loading...</em></p>
                }
                else if (versions.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> No versions uploaded yet.
                    </div>
                }
                else
                {
                    <div class="list-group mb-0">
                        @foreach (PlayerVersion v in versions)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1"><code>@v.VersionNumber</code></h6>
                                        <small class="text-muted">
                                            @v.UploadedAt.ToString("yyyy-MM-dd HH:mm") UTC
                                            &middot; @FormatBytes(v.FileSizeBytes)
                                        </small>
                                        @if (!string.IsNullOrWhiteSpace(v.Notes))
                                        {
                                            <div><small class="text-secondary">@v.Notes</small></div>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteVersion(v.Id)"
                                            disabled="@deletingId.HasValue">
                                        @if (deletingId == v.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-trash"></i>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-upload"></i> Upload New Version</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Version Number</label>
                    <input class="form-control" placeholder="e.g. 1.2.0" @bind="uploadVersion" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Binary (linux-arm64 self-contained)</label>
                    <InputFile OnChange="OnFileSelected" class="form-control" accept="*" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Release notes <span class="text-muted">(optional)</span></label>
                    <input class="form-control" placeholder="What changed?" @bind="uploadNotes" />
                </div>
                @if (uploading)
                {
                    <div class="progress mb-3" style="height: 10px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
                    </div>
                }
                @if (uploadError != null)
                {
                    <div class="alert alert-danger py-2">@uploadError</div>
                }
                <button class="btn btn-primary"
                        @onclick="UploadVersion"
                        disabled="@(uploading || selectedFile == null || string.IsNullOrWhiteSpace(uploadVersion))">
                    @if (uploading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Uploading...</span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-upload me-1"></i>
                        <span>Upload</span>
                    }
                </button>
                <small class="text-muted ms-2">
                    Build with: <code>dotnet publish -r linux-arm64 --self-contained -p:PublishSingleFile=true</code>
                </small>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Group Version Assignments</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">Assign versions to device groups for canary deployments. Unassigned groups fall back to "Default".</p>

                @if (groups == null)
                {
                    <p><em>Loading...</em></p>
                }
                else
                {
                    @foreach (DeviceGroupVersion g in groups)
                    {
                        <div class="card mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">@g.GroupName</h6>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteGroup(g.GroupName)"
                                            disabled="@(g.GroupName == "Default")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <div class="mt-1">
                                    <select class="form-select form-select-sm"
                                            @onchange="e => SaveGroupVersion(g.GroupName, e.Value?.ToString() ?? g.TargetVersion)"
                                            disabled="@(versions == null || versions.Count == 0)">
                                        @if (versions != null)
                                        {
                                            @foreach (PlayerVersion v in versions)
                                            {
                                                <option value="@v.VersionNumber" selected="@(v.VersionNumber == g.TargetVersion)">@v.VersionNumber</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="input-group input-group-sm mt-3">
                        <input class="form-control" placeholder="New group name" @bind="newGroupName" />
                        <button class="btn btn-outline-primary"
                                @onclick="AddGroup"
                                disabled="@(string.IsNullOrWhiteSpace(newGroupName) || versions == null || versions.Count == 0)">
                            <i class="bi bi-plus-circle"></i> Add
                        </button>
                    </div>
                    @if (groupError != null)
                    {
                        <div class="alert alert-danger py-1 mt-2 small">@groupError</div>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Canary Deployment Workflow</h5>
            </div>
            <div class="card-body">
                <ol class="small mb-0">
                    <li>Upload the new player binary above</li>
                    <li>Assign the new version to a small test group (e.g. "Lab")</li>
                    <li>Monitor those devices via the Device Dashboard</li>
                    <li>Use Screenshot to verify correct operation</li>
                    <li>Assign the version to "Default" — all unassigned groups follow</li>
                    <li>Devices auto-update within 30–60 seconds via heartbeat</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@code {
    private List<PlayerVersion>? versions;
    private List<DeviceGroupVersion>? groups;
    private HttpClient? httpClient;

    private string uploadVersion = string.Empty;
    private string? uploadNotes;
    private IBrowserFile? selectedFile;
    private bool uploading;
    private string? uploadError;

    private string? newGroupName;
    private string? groupError;
    private int? deletingId;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        httpClient = HttpClientFactory.CreateClient();
        httpClient.BaseAddress = new Uri(Navigation.BaseUri);
        await LoadAll();
    }

    private async Task LoadAll()
    {
        try
        {
            versions = await httpClient!.GetFromJsonAsync<List<PlayerVersion>>("/api/versions");
            groups = await httpClient!.GetFromJsonAsync<List<DeviceGroupVersion>>("/api/versions/groups");
            loadError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading versions page data");
            loadError = "Failed to load data from server.";
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadVersion()
    {
        if (selectedFile == null || string.IsNullOrWhiteSpace(uploadVersion)) return;

        uploading = true;
        uploadError = null;
        try
        {
            using MultipartFormDataContent form = new();
            form.Add(new StringContent(uploadVersion.Trim()), "versionNumber");
            if (!string.IsNullOrWhiteSpace(uploadNotes))
                form.Add(new StringContent(uploadNotes), "notes");

            Stream stream = selectedFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            form.Add(new StreamContent(stream), "file", selectedFile.Name);

            HttpResponseMessage response = await httpClient!.PostAsync("/api/versions", form);
            if (response.IsSuccessStatusCode)
            {
                uploadVersion = string.Empty;
                uploadNotes = null;
                selectedFile = null;
                await LoadAll();
            }
            else
            {
                string body = await response.Content.ReadAsStringAsync();
                uploadError = $"Upload failed ({(int)response.StatusCode}): {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading version");
            uploadError = "Upload failed — check logs for details.";
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task DeleteVersion(int id)
    {
        deletingId = id;
        loadError = null;
        try
        {
            HttpResponseMessage response = await httpClient!.DeleteAsync($"/api/versions/{id}");
            if (response.IsSuccessStatusCode)
                await LoadAll();
            else
            {
                string body = await response.Content.ReadAsStringAsync();
                loadError = $"Delete failed ({(int)response.StatusCode}): {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting version {Id}", id);
            loadError = "Delete failed — see logs for details.";
        }
        finally
        {
            deletingId = null;
        }
    }

    private async Task SaveGroupVersion(string groupName, string targetVersion)
    {
        try
        {
            HttpResponseMessage response = await httpClient!.PutAsJsonAsync(
                $"/api/versions/groups/{Uri.EscapeDataString(groupName)}",
                new { TargetVersion = targetVersion });

            if (!response.IsSuccessStatusCode)
            {
                string body = await response.Content.ReadAsStringAsync();
                groupError = $"Save failed ({(int)response.StatusCode}): {body}";
            }
            else
                groupError = null;

            await LoadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving group version for {Group}", groupName);
            groupError = "Save failed — check server logs.";
        }
    }

    private async Task AddGroup()
    {
        if (string.IsNullOrWhiteSpace(newGroupName) || versions == null || versions.Count == 0) return;

        // Default to the version assigned to the 'Default' group, or fallback to the first version
        string defaultVersion = groups?.FirstOrDefault(g => g.GroupName == "Default")?.TargetVersion 
                               ?? versions[0].VersionNumber;
        groupError = null;

        try
        {
            HttpResponseMessage response = await httpClient!.PutAsJsonAsync(
                $"/api/versions/groups/{Uri.EscapeDataString(newGroupName.Trim())}",
                new { TargetVersion = defaultVersion });

            if (response.IsSuccessStatusCode)
            {
                newGroupName = null;
                await LoadAll();
            }
            else
            {
                string body = await response.Content.ReadAsStringAsync();
                groupError = $"Failed to add group ({(int)response.StatusCode}): {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding group {Group}", newGroupName);
            groupError = "Failed to add group.";
        }
    }

    private async Task DeleteGroup(string groupName)
    {
        try
        {
            HttpResponseMessage response = await httpClient!.DeleteAsync(
                $"/api/versions/groups/{Uri.EscapeDataString(groupName)}");

            if (response.IsSuccessStatusCode)
                await LoadAll();
            else
            {
                string body = await response.Content.ReadAsStringAsync();
                groupError = $"Delete failed ({(int)response.StatusCode}): {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting group {Group}", groupName);
            groupError = "Delete failed.";
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024.0 / 1024.0:F1} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024.0:F1} KB";
        return $"{bytes} B";
    }

    public void Dispose()
    {
        httpClient?.Dispose();
    }
}
