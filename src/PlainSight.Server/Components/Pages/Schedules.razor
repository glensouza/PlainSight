@page "/schedules"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<PlainSightDbContext> DbFactory
@inject ILogger<Schedules> Logger
@inject IJSRuntime JS
@inject IConfiguration Configuration
@using Microsoft.EntityFrameworkCore
@using PlainSight.Shared.Models
@using PlainSight.Server.Data

<PageTitle>Schedules — PlainSight</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h1>Content Schedules</h1>
        <p class="text-muted">
            Define when and where your playlists should play. 
            <span class="badge bg-light text-dark border ms-2">
                <i class="bi bi-clock me-1"></i>
                Server Time: @GetDisplayTime() (@(Configuration["SystemTimeZone"] ?? "Local"))
            </span>
        </p>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreateForm">
        <i class="bi bi-calendar-plus me-1"></i> New Schedule
    </button>
</div>

@if (schedules == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Loading schedules...</p>
    </div>
}
else if (!schedules.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
            <h5 class="mt-3">No schedules found</h5>
            <p class="text-muted">Create a schedule to start displaying content on your devices.</p>
            <button class="btn btn-outline-primary mt-2" @onclick="ShowCreateForm">
                Create First Schedule
            </button>
        </div>
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3 border">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Target Groups</th>
                    <th>Playlist</th>
                    <th>Timing</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var schedule in schedules.OrderByDescending(s => s.Priority))
                {
                    <tr>
                        <td>
                            <strong>@schedule.Name</strong>
                            @if (schedule.ScheduledDate.HasValue)
                            {
                                <div class="small text-warning"><i class="bi bi-info-circle me-1"></i>One-time</div>
                            }
                        </td>
                        <td>
                            @if (schedule.TargetGroups == null || schedule.TargetGroups.Count == 0)
                            {
                                <span class="badge bg-secondary">All Groups</span>
                            }
                            else
                            {
                                <div class="d-flex gap-1 flex-wrap" style="max-width: 250px;">
                                    @foreach (var tg in schedule.TargetGroups)
                                    {
                                        <span class="badge bg-info text-dark">@tg.GroupName</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>@schedule.Playlist.Name</td>
                        <td>
                            <div class="small">
                                <code>@schedule.StartTime.ToString("HH:mm")</code> – <code>@schedule.EndTime.ToString("HH:mm")</code>
                            </div>
                            @if (schedule.ScheduledDate.HasValue)
                            {
                                <div class="small text-muted">@schedule.ScheduledDate.Value.ToShortDateString()</div>
                            }
                            else
                            {
                                <div class="d-flex gap-1 mt-1">
                                    @foreach (var day in GetSelectedDays(schedule.DaysOfWeek))
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">@day</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge bg-primary">@schedule.Priority</span>
                        </td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" checked="@schedule.IsActive" 
                                       @onchange="() => ToggleActive(schedule)" />
                                <span class="badge @(schedule.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                    @(schedule.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditSchedule(schedule)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(schedule)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title">@(editingId.HasValue ? "Edit" : "Create") Schedule</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Schedule Name</label>
                            <input type="text" class="form-control" @bind="formModel.Name" placeholder="e.g., Morning Announcements" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Priority (Higher Wins)</label>
                            <input type="number" class="form-control" @bind="formModel.Priority" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold d-block">Target Device Groups</label>
                            <div class="dropdown" style="position: relative;">
                                <button class="btn btn-outline-secondary dropdown-toggle w-100 d-flex justify-content-between align-items-center rounded" 
                                        type="button" @onclick="ToggleGroupDropdown">
                                    <span>
                                        @if (formModel.TargetGroups.Count == 0)
                                        {
                                            <span class="text-muted">All Groups (Global)</span>
                                        }
                                        else
                                        {
                                            @foreach (string gName in formModel.TargetGroups)
                                            {
                                                <span class="badge bg-primary me-1">@gName</span>
                                            }
                                        }
                                    </span>
                                </button>
                                @if (showGroupDropdown)
                                {
                                    <div class="dropdown-menu w-100 shadow show" style="display: block;">
                                        <button class="dropdown-item" type="button" @onclick="() => { formModel.TargetGroups.Clear(); showGroupDropdown = false; }">
                                            <i class="bi @(formModel.TargetGroups.Count == 0 ? "bi-check-circle-fill text-primary" : "bi-circle") me-2"></i>
                                            <strong>All Groups (Global)</strong>
                                        </button>
                                        <hr class="dropdown-divider my-1">
                                        @foreach (var g in deviceGroups ?? new())
                                        {
                                            <button class="dropdown-item" type="button" @onclick="() => ToggleGroup(g.Name)">
                                                <i class="bi @(formModel.TargetGroups.Contains(g.Name) ? "bi-check-square-fill text-primary" : "bi-square") me-2"></i>
                                                @g.Name
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Playlist</label>
                            <select class="form-select" @bind="formModel.PlaylistId">
                                <option value="0">-- Select Playlist --</option>
                                @foreach (var playlist in playlists ?? new())
                                {
                                    <option value="@playlist.Id">@playlist.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold d-block">Schedule Type</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="stype" id="st_rec" checked="@(!formModel.UseSpecificDate)" @onchange="() => formModel.UseSpecificDate = false" />
                                <label class="form-check-label" for="st_rec">Recurring</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="stype" id="st_one" checked="@(formModel.UseSpecificDate)" @onchange="() => formModel.UseSpecificDate = true" />
                                <label class="form-check-label" for="st_one">One-time</label>
                            </div>
                        </div>

                        @if (formModel.UseSpecificDate)
                        {
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Event Date</label>
                                <input type="date" class="form-control" @bind="formModel.ScheduledDate" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12">
                                <label class="form-label fw-bold mb-2">Days of Week</label>
                                <div class="d-flex gap-2 flex-wrap bg-light p-3 rounded-3 border">
                                    @foreach (DayOfWeekFlags day in Enum.GetValues<DayOfWeekFlags>().Where(d => d != DayOfWeekFlags.None && d != DayOfWeekFlags.All))
                                    {
                                        <div class="form-check form-check-inline m-0 me-2">
                                            <input class="form-check-input" type="checkbox" id="day-@day" 
                                                   checked="@((formModel.DaysOfWeek & day) != 0)"
                                                   @onchange="e => ToggleDay(day, (bool)e.Value!)" />
                                            <label class="form-check-label" for="day-@day">@day</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Start Time</label>
                            <input type="time" class="form-control" @bind="formModel.StartTime" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">End Time</label>
                            <input type="time" class="form-control" @bind="formModel.EndTime" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button class="btn btn-light" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary px-4" @onclick="SaveSchedule" disabled="@(formModel.PlaylistId == 0 || saving)">
                        <i class="bi bi-check-lg me-1"></i> @(editingId.HasValue ? "Update" : "Create") Schedule
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm && deleteTarget != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-danger">Delete Schedule</h5>
                    <button type="button" class="btn-close" @onclick="() => showDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete the schedule <strong>@deleteTarget.Name</strong>?
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-light" @onclick="() => showDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteSchedule">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Schedule>? schedules;
    private List<Playlist>? playlists;
    private List<DeviceGroup>? deviceGroups;

    private bool showForm;
    private bool showGroupDropdown;
    private bool saving;
    private int? editingId;
    private ScheduleFormModel formModel = new();
    
    private bool showDeleteConfirm;
    private Schedule? deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        schedules = await context.Schedules
            .Include(s => s.Playlist)
            .Include(s => s.TargetGroups)
            .OrderByDescending(s => s.Priority)
            .ToListAsync();
            
        playlists = await context.Playlists
            .OrderBy(p => p.Name)
            .ToListAsync();
            
        deviceGroups = await context.DeviceGroups
            .OrderBy(g => g.Name)
            .ToListAsync();
    }

    private void ShowCreateForm()
    {
        editingId = null;
        formModel = new ScheduleFormModel();
        showForm = true;
    }

    private void EditSchedule(Schedule s)
    {
        editingId = s.Id;
        formModel = new ScheduleFormModel
        {
            Name = s.Name,
            PlaylistId = s.PlaylistId,
            TargetGroups = s.TargetGroups.Select(tg => tg.GroupName).ToList(),
            DaysOfWeek = s.DaysOfWeek,
            ScheduledDate = s.ScheduledDate,
            UseSpecificDate = s.ScheduledDate.HasValue,
            StartTime = s.StartTime,
            EndTime = s.EndTime,
            Priority = s.Priority,
            IsActive = s.IsActive
        };
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        showGroupDropdown = false;
    }

    private void ToggleGroupDropdown() => showGroupDropdown = !showGroupDropdown;

    private void ToggleGroup(string groupName)
    {
        if (formModel.TargetGroups.Contains(groupName))
            formModel.TargetGroups.Remove(groupName);
        else
            formModel.TargetGroups.Add(groupName);
    }

    private void ToggleDay(DayOfWeekFlags day, bool value)
    {
        if (value)
            formModel.DaysOfWeek |= day;
        else
            formModel.DaysOfWeek &= ~day;
    }

    private async Task SaveSchedule()
    {
        saving = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            Schedule? entity;
            if (editingId.HasValue)
            {
                entity = await context.Schedules
                    .Include(s => s.TargetGroups)
                    .FirstOrDefaultAsync(s => s.Id == editingId.Value);
                
                if (entity == null) return;

                entity.Name = formModel.Name;
                entity.PlaylistId = formModel.PlaylistId;
                entity.DaysOfWeek = formModel.UseSpecificDate ? DayOfWeekFlags.None : formModel.DaysOfWeek;
                entity.ScheduledDate = formModel.UseSpecificDate ? formModel.ScheduledDate : null;
                entity.StartTime = formModel.StartTime;
                entity.EndTime = formModel.EndTime;
                entity.Priority = formModel.Priority;
                entity.IsActive = formModel.IsActive;
                entity.UpdatedAt = DateTime.UtcNow;

                // Sync groups
                context.RemoveRange(entity.TargetGroups);
                entity.TargetGroups = formModel.TargetGroups.Select(g => new ScheduleTargetGroup { GroupName = g }).ToList();
            }
            else
            {
                entity = new Schedule
                {
                    Name = formModel.Name,
                    PlaylistId = formModel.PlaylistId,
                    DaysOfWeek = formModel.UseSpecificDate ? DayOfWeekFlags.None : formModel.DaysOfWeek,
                    ScheduledDate = formModel.UseSpecificDate ? formModel.ScheduledDate : null,
                    StartTime = formModel.StartTime,
                    EndTime = formModel.EndTime,
                    Priority = formModel.Priority,
                    IsActive = formModel.IsActive,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow,
                    TargetGroups = formModel.TargetGroups.Select(g => new ScheduleTargetGroup { GroupName = g }).ToList()
                };
                context.Schedules.Add(entity);
            }

            await context.SaveChangesAsync();
            showForm = false;
            await LoadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving schedule");
        }
        finally
        {
            saving = false;
        }
    }

    private void ConfirmDelete(Schedule s)
    {
        deleteTarget = s;
        showDeleteConfirm = true;
    }

    private async Task DeleteSchedule()
    {
        if (deleteTarget == null) return;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var existing = await context.Schedules.FindAsync(deleteTarget.Id);
            if (existing != null)
            {
                context.Schedules.Remove(existing);
                await context.SaveChangesAsync();
                showDeleteConfirm = false;
                await LoadAll();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting schedule");
        }
    }

    private async Task ToggleActive(Schedule s)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var existing = await context.Schedules.FindAsync(s.Id);
            if (existing != null)
            {
                existing.IsActive = !existing.IsActive;
                existing.UpdatedAt = DateTime.UtcNow;
                await context.SaveChangesAsync();
                await LoadAll();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling schedule status");
        }
    }

    private string GetDisplayTime()
    {
        string? tzId = Configuration["SystemTimeZone"];
        if (string.IsNullOrEmpty(tzId)) return DateTime.Now.ToString("HH:mm");
        
        try
        {
            TimeZoneInfo tz = TimeZoneInfo.FindSystemTimeZoneById(tzId);
            return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz).ToString("HH:mm");
        }
        catch
        {
            return DateTime.Now.ToString("HH:mm");
        }
    }

    private List<string> GetSelectedDays(DayOfWeekFlags days)
    {
        if (days == DayOfWeekFlags.All) return new List<string> { "Daily" };
        
        var list = new List<string>();
        foreach (DayOfWeekFlags day in Enum.GetValues<DayOfWeekFlags>().Where(d => d != DayOfWeekFlags.None && d != DayOfWeekFlags.All))
        {
            if ((days & day) != 0) list.Add(day.ToString().Substring(0, 3));
        }
        return list;
    }

    private sealed class ScheduleFormModel
    {
        public string Name { get; set; } = "";
        public int PlaylistId { get; set; }
        public List<string> TargetGroups { get; set; } = new();
        public bool UseSpecificDate { get; set; }
        public DayOfWeekFlags DaysOfWeek { get; set; } = DayOfWeekFlags.All;
        public DateOnly? ScheduledDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public TimeOnly StartTime { get; set; } = new TimeOnly(0, 0);
        public TimeOnly EndTime { get; set; } = new TimeOnly(23, 59, 59);
        public int Priority { get; set; } = 1;
        public bool IsActive { get; set; } = true;
    }
}
