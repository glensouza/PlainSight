@page "/devices/{DeviceId}/vnc"
@using Microsoft.AspNetCore.Authorization
@layout VncLayout
@attribute [Authorize(Roles = "Admin")]

@* Static-rendered host for the noVNC ES module. This page owns no Blazor interactivity on
   purpose: the noVNC client manages its own canvas and WebSocket in the browser. It is meant
   to be opened in a new tab (a full page load), so the module script below runs on load. *@

<PageTitle>Live view — @DeviceId</PageTitle>

<div id="vnc-screen" data-device-id="@DeviceId"></div>

<div id="vnc-overlay">
    <form id="vnc-login">
        <h1>Live view</h1>
        <p class="vnc-device">@DeviceId</p>
        <p id="vnc-status" class="vnc-status"></p>
        <label>
            Username
            <input id="vnc-username" type="text" value="pi" autocomplete="username" />
        </label>
        <label>
            Password
            <input id="vnc-password" type="password" autocomplete="current-password" autofocus />
        </label>
        <button type="submit" id="vnc-connect">Connect</button>
    </form>
</div>

<style>
    html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
    #vnc-screen { position: fixed; inset: 0; background: #000; }
    #vnc-overlay {
        position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
        background: #0a0a14; z-index: 10;
    }
    #vnc-overlay.hidden { display: none; }
    #vnc-login {
        display: flex; flex-direction: column; gap: .75rem; width: 320px;
        padding: 2rem; background: #16161f; border: 1px solid #2a2a3a; border-radius: 12px;
        color: #e8e8f0; font-family: system-ui, sans-serif;
    }
    #vnc-login h1 { margin: 0; font-size: 1.25rem; }
    #vnc-login .vnc-device { margin: 0; font-size: .85rem; color: #8a8aa0; font-family: monospace; }
    #vnc-login label { display: flex; flex-direction: column; gap: .25rem; font-size: .8rem; color: #b8b8c8; }
    #vnc-login input {
        padding: .5rem; border-radius: 6px; border: 1px solid #2a2a3a;
        background: #0e0e16; color: #e8e8f0; font-size: .95rem;
    }
    #vnc-connect {
        margin-top: .5rem; padding: .6rem; border: none; border-radius: 6px;
        background: #4f46e5; color: #fff; font-size: .95rem; cursor: pointer;
    }
    #vnc-connect:disabled { opacity: .5; cursor: default; }
    .vnc-status { margin: 0; font-size: .8rem; min-height: 1rem; color: #f08a8a; }
    .vnc-status.info { color: #8a8aa0; }
</style>

<script type="module">
    import RFB from '/lib/novnc/core/rfb.js';

    const screen = document.getElementById('vnc-screen');
    const overlay = document.getElementById('vnc-overlay');
    const form = document.getElementById('vnc-login');
    const statusEl = document.getElementById('vnc-status');
    const connectBtn = document.getElementById('vnc-connect');
    const deviceId = screen.dataset.deviceId;

    const proto = location.protocol === 'https:' ? 'wss' : 'ws';
    const url = `${proto}://${location.host}/api/device/${encodeURIComponent(deviceId)}/vnc`;

    let rfb = null;

    function setStatus(message, isInfo) {
        statusEl.textContent = message;
        statusEl.classList.toggle('info', !!isInfo);
    }

    function showOverlay() { overlay.classList.remove('hidden'); }
    function hideOverlay() { overlay.classList.add('hidden'); }

    form.addEventListener('submit', (e) => {
        e.preventDefault();
        const username = document.getElementById('vnc-username').value;
        const password = document.getElementById('vnc-password').value;
        connectBtn.disabled = true;
        setStatus('Connecting…', true);

        rfb = new RFB(screen, url, { credentials: { username, password } });
        rfb.viewOnly = true;
        rfb.scaleViewport = true;
        rfb.background = '#000';

        rfb.addEventListener('connect', () => {
            setStatus('', true);
            hideOverlay();
        });
        rfb.addEventListener('credentialsrequired', () => {
            rfb.sendCredentials({ username, password });
        });
        rfb.addEventListener('securityfailure', (ev) => {
            connectBtn.disabled = false;
            setStatus('Authentication failed' + (ev.detail && ev.detail.reason ? ': ' + ev.detail.reason : ''), false);
            showOverlay();
        });
        rfb.addEventListener('disconnect', (ev) => {
            connectBtn.disabled = false;
            if (!ev.detail || !ev.detail.clean) {
                setStatus('Disconnected — check the player is online and wayvnc is running.', false);
            }
            showOverlay();
        });
    });
</script>

@code {
    [Parameter]
    public string DeviceId { get; set; } = string.Empty;
}
