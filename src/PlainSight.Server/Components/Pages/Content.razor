@page "/content"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<PlainSightDbContext> DbFactory
@inject ContentSyncService ContentSyncService
@inject MediaMetadataService MediaMetadataService
@inject VideoProcessorService VideoProcessorService
@inject RenderQueue RenderQueue
@inject IConfiguration Configuration
@inject ILogger<Content> Logger
@inject YouTubeDownloadQueue YouTubeDownloadQueue
@implements IDisposable

<PageTitle>Content Library — PlainSight</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h1>Content Library</h1>
        <p class="text-muted mb-0">Manage media files and rendered content for your digital signage</p>
    </div>
    <button class="btn btn-sm btn-outline-secondary" @onclick="RunSync" disabled="@syncing">
        @if (syncing)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
        else
        {
            <i class="bi bi-arrow-repeat"></i>
        }
        <span> Sync folder</span>
    </button>
</div>

@if (syncMessage != null)
{
    <div class="alert alert-info alert-dismissible py-2 mt-2 mb-0" role="alert">
        <i class="bi bi-info-circle"></i> @syncMessage
        <button type="button" class="btn-close" @onclick="() => syncMessage = null"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-cloud-upload"></i> Upload Content</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Upload Video or Image</label>
                            <InputFile class="form-control" accept="video/*,image/*" OnChange="HandleFileSelected" />
                            <small class="text-muted">Supported: MP4, AVI, MOV, PNG, JPG — max 500 MB</small>
                        </div>
                        @if (uploadError != null)
                        {
                            <div class="alert alert-danger py-1 px-2 mb-2">
                                <small><i class="bi bi-exclamation-triangle"></i> @uploadError</small>
                            </div>
                        }
                        <button class="btn btn-primary" @onclick="UploadFile" disabled="@(uploading || selectedFile == null)">
                            @if (uploading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Uploading...</span>
                            }
                            else
                            {
                                <i class="bi bi-upload"></i>
                                <span>Upload File</span>
                            }
                        </button>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6><i class="bi bi-globe"></i> Render Website to Video</h6>
                                <div class="mb-2">
                                    <input type="text" class="form-control form-control-sm" placeholder="https://example.com" @bind="renderUrl" />
                                </div>
                                <div class="mb-2">
                                    <input type="number" class="form-control form-control-sm" placeholder="Duration (seconds)" @bind="renderDuration" min="5" max="300" />
                                </div>
                                @if (renderSubmitError != null)
                                {
                                    <div class="alert alert-danger py-1 px-2 mb-2">
                                        <small><i class="bi bi-exclamation-triangle"></i> @renderSubmitError</small>
                                    </div>
                                }
                                <button class="btn btn-sm btn-outline-primary" @onclick="SubmitRender">
                                    <i class="bi bi-camera-video"></i>
                                    <span>Queue Render</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6><i class="bi bi-youtube"></i> Download from YouTube</h6>
                                <div class="mb-2">
                                    <input type="text" class="form-control form-control-sm" placeholder="https://youtube.com/watch?v=..." @bind="youtubeUrl" />
                                </div>
                                <button class="btn btn-sm btn-outline-danger" @onclick="EnqueueYouTubeDownload" disabled="@string.IsNullOrWhiteSpace(youtubeUrl)">
                                    <i class="bi bi-cloud-arrow-down"></i>
                                    <span>Download</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (renderJobs.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            <h6 class="mb-0"><i class="bi bi-clock-history"></i> Render Queue</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <tbody>
                    @foreach (RenderJobState job in renderJobs)
                    {
                        <tr>
                            <td class="ps-3">
                                @if (job.Status is "Queued" or "Processing")
                                {
                                    <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                }
                                else if (job.Status == "Done")
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                }
                            </td>
                            <td><small class="text-truncate d-inline-block" style="max-width:300px">@job.Url</small></td>
                            <td><small>@job.DurationSeconds s</small></td>
                            <td>
                                <span class="badge @(job.Status switch { "Done" => "bg-success", "Failed" => "bg-danger", "Processing" => "bg-primary", _ => "bg-secondary" })">
                                    @job.Status
                                </span>
                                @if (job.Error != null)
                                {
                                    <small class="text-danger ms-1">@job.Error</small>
                                }
                            </td>
                            <td>
                                @if (job.Status is "Done" or "Failed")
                                {
                                    <button class="btn btn-sm btn-link py-0" @onclick="() => renderJobs.Remove(job)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (youtubeJobs.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            <h6 class="mb-0"><i class="bi bi-youtube"></i> YouTube Download Queue</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <tbody>
                    @foreach (YouTubeJobState job in youtubeJobs)
                    {
                        <tr>
                            <td class="ps-3">
                                @if (job.Status is "Queued" or "Processing")
                                {
                                    <span class="spinner-border spinner-border-sm text-danger" role="status"></span>
                                }
                                else if (job.Status == "Done")
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                }
                            </td>
                            <td><small class="text-truncate d-inline-block" style="max-width:300px">@job.Url</small></td>
                            <td>
                                <span class="badge @(job.Status switch { "Done" => "bg-success", "Failed" => "bg-danger", "Processing" => "bg-danger", _ => "bg-secondary" })">
                                    @job.Status
                                </span>
                                @if (job.Status == "Done" && job.DownloadedTitle != null)
                                {
                                    <small class="text-muted ms-1">@job.DownloadedTitle</small>
                                }
                                @if (job.Error != null)
                                {
                                    <small class="text-danger ms-1">@job.Error</small>
                                }
                            </td>
                            <td>
                                @if (job.Status is "Done" or "Failed")
                                {
                                    <button class="btn btn-sm btn-link py-0" @onclick="() => youtubeJobs.Remove(job)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (contentItems == null)
{
    <p><em>Loading content library...</em></p>
}
else if (contentItems.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No content uploaded yet. Upload videos or images, or render websites to get started.
    </div>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="input-group" style="max-width: 360px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" class="form-control" placeholder="Search by name or file name..." @bind="searchTerm" @bind:event="oninput" @bind:after="RecomputeFilteredItems" />
        </div>
        <small class="text-muted">@FilteredItems.Count of @contentItems.Count items</small>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th style="cursor: pointer;" @onclick='() => SortBy("Type")'>Type <i class="bi @SortIcon("Type")"></i></th>
                    <th style="cursor: pointer;" @onclick='() => SortBy("Name")'>Name <i class="bi @SortIcon("Name")"></i></th>
                    <th style="cursor: pointer;" @onclick='() => SortBy("FileName")'>File Name <i class="bi @SortIcon("FileName")"></i></th>
                    <th style="cursor: pointer;" @onclick='() => SortBy("Duration")'>Duration <i class="bi @SortIcon("Duration")"></i></th>
                    <th style="cursor: pointer;" @onclick='() => SortBy("Size")'>Size <i class="bi @SortIcon("Size")"></i></th>
                    <th style="cursor: pointer;" @onclick='() => SortBy("Uploaded")'>Uploaded <i class="bi @SortIcon("Uploaded")"></i></th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ContentItem item in FilteredItems)
                {
                    <tr>
                        <td>
                            @switch (item.Type)
                            {
                                case ContentType.Video:
                                    <span class="badge bg-primary"><i class="bi bi-play-circle"></i> Video</span>
                                    break;
                                case ContentType.Image:
                                    <span class="badge bg-success"><i class="bi bi-image"></i> Image</span>
                                    break;
                                case ContentType.RenderedWebsite:
                                default:
                                    <span class="badge bg-info"><i class="bi bi-globe"></i> Rendered</span>
                                    break;
                            }
                        </td>
                        <td>@item.Name</td>
                        <td><code>@item.FileName</code></td>
                        <td>@item.DurationSeconds s</td>
                        <td>@FormatFileSize(item.FileSizeBytes)</td>
                        <td>@item.UploadedAt.ToLocalString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" @onclick="() => PreviewContent(item)" title="Preview">
                                    <i class="bi bi-eye"></i>
                                </button>
                                @if (item.Type != ContentType.Image)
                                {
                                    <button class="btn btn-outline-info" @onclick="() => StartProcessing(item)" title="Process Video">
                                        <i class="bi bi-gear"></i>
                                    </button>
                                }
                                <button class="btn btn-outline-secondary" @onclick="() => StartRename(item)" title="Rename">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(item)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (FilteredItems.Count == 0)
        {
            <div class="alert alert-secondary mb-0">
                <i class="bi bi-search"></i> No content matches "@searchTerm".
            </div>
        }
    </div>
}

@if (renamingItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rename Content</h5>
                    <button type="button" class="btn-close" @onclick="CancelRename"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Display Name</label>
                        <input type="text" class="form-control" @bind="newName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">File Name (on disk)</label>
                        <input type="text" class="form-control" @bind="newFileName" />
                        <small class="text-muted">Extension will be preserved automatically.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Duration (seconds)</label>
                        @{
                            bool isVideo = renamingItem.Type == ContentType.Video;
                        }
                        <input type="number" class="form-control" @bind="newDuration" min="1" max="3600" readonly="@isVideo" disabled="@isVideo" />
                        @if (isVideo)
                        {
                            <small class="text-muted">Video duration is detected automatically.</small>
                        }
                        else
                        {
                            <small class="text-muted">How long this item displays (especially for images).</small>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Companion Clip</label>
                        <select class="form-select" @bind="companionContentItemId">
                            <option value="">— None —</option>
                            @foreach (ContentItem ci in contentItems ?? [])
                            {
                                if (ci.Id != renamingItem.Id)
                                {
                                    <option value="@ci.Id">@ci.Name (@ci.FileName)</option>
                                }
                            }
                        </select>
                        <small class="text-muted">An extra clip inserted adjacent to this item in the playlist.</small>
                    </div>
                    @if (!string.IsNullOrEmpty(companionContentItemId))
                    {
                        <div class="mb-3">
                            <label class="form-label">Companion Position</label>
                            <div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" id="compBefore" name="companionPos" value="Before" checked="@(companionPosition == "Before")" @onchange="@(() => this.companionPosition = "Before")" />
                                    <label class="form-check-label" for="compBefore">Before</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" id="compAfter" name="companionPos" value="After" checked="@(companionPosition == "After")" @onchange="@(() => this.companionPosition = "After")" />
                                    <label class="form-check-label" for="compAfter">After</label>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelRename">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="PerformRename">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

@if (processingItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Process Video: @processingItem.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => processingItem = null"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Choose options to modify this video file. This will replace the existing file.</p>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="procStripAudio" @bind="stripAudio" />
                            <label class="form-check-label" for="procStripAudio">
                                Strip Audio
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="procCompressVideo" @bind="compressVideo" />
                            <label class="form-check-label" for="procCompressVideo">
                                Smaller File Size (Compression)
                            </label>
                        </div>
                    </div>
                    @if (isProcessingExisting)
                    {
                        <div class="alert alert-info py-2">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            Processing video... please wait.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => processingItem = null" disabled="@isProcessingExisting">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="PerformProcessing" disabled="@(isProcessingExisting || (!stripAudio && !compressVideo))">
                        Process and Replace
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (itemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog shadow-lg">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fs-6">Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => itemToDelete = null"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete <strong>@itemToDelete.Name</strong>?</p>
                    <p class="text-danger mb-0"><small><i class="bi bi-exclamation-triangle"></i> This will permanently remove the file from disk.</small></p>
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => itemToDelete = null">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteContent(itemToDelete.Id)">Delete Permanently</button>
                </div>
            </div>
        </div>
    </div>
}

@if (previewItem != null)
{
    string previewName = previewItem.Name;
    string previewFileName = previewItem.FileName;
    string apiPath = $"/api/media/content/{previewFileName}?v={previewItem.FileSizeBytes}";
    bool isImage = previewItem.Type == ContentType.Image;
    long fileSize = previewItem.FileSizeBytes;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.8);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header py-2">
                    <h6 class="modal-title text-truncate">@previewName</h6>
                    <button type="button" class="btn-close" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body p-0 bg-dark d-flex align-items-center justify-content-center" style="min-height: 400px;">
                    @if (isImage)
                    {
                        <img src="@apiPath" class="img-fluid" style="max-height: 70vh;" alt="@previewName"/>
                    }
                    else
                    {
                        <video controls autoplay class="w-100" style="max-height: 70vh;">
                            <source src="@apiPath" type="@GetVideoType(previewFileName)" />
                            Your browser does not support the video tag.
                        </video>
                    }
                </div>
                <div class="modal-footer py-1">
                    <small class="text-muted">@previewFileName (@FormatFileSize(fileSize))</small>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private sealed class RenderJobState
    {
        public string JobId { get; init; } = "";
        public string Url { get; init; } = "";
        public int DurationSeconds { get; init; }
        public string Status { get; set; } = "Queued";
        public string? Error { get; set; }
    }

    private sealed class YouTubeJobState
    {
        public string JobId { get; init; } = "";
        public string Url { get; init; } = "";
        public string Status { get; set; } = "Queued";
        public string? Error { get; set; }
        public string? DownloadedTitle { get; set; }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task<bool> IsAdminAsync()
    {
        if (this.AuthState == null)
        {
            return false;
        }

        AuthenticationState state = await this.AuthState;
        return state.User.IsInRole("Admin");
    }

    private List<ContentItem>? contentItems;
    private string searchTerm = "";
    private string sortColumn = "Name";
    private bool sortAscending = true;
    private bool uploading;
    private bool syncing;
    private IBrowserFile? selectedFile;
    private bool stripAudio;
    private bool compressVideo;
    private string? uploadError;
    private string renderUrl = "";
    private int renderDuration = 30;
    private string? renderSubmitError;
    private string? syncMessage;
    private readonly List<RenderJobState> renderJobs = [];
    private bool isPolling;
    private ContentItem? previewItem;
    private ContentItem? processingItem;
    private bool isProcessingExisting;
    private ContentItem? renamingItem;
    private string newName = "";
    private string newFileName = "";
    private int newDuration = 10;
    private string companionContentItemId = "";
    private string companionPosition = "After";
    private ContentItem? itemToDelete;
    private string youtubeUrl = "";
    private readonly List<YouTubeJobState> youtubeJobs = [];
    private bool isPollingYouTube;
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        // Render from the database first so the page paints immediately,
        // then reconcile with the SMB folder in the background. The
        // ContentSyncWorkerService also syncs periodically, so a slow or
        // unmounted share never blocks the initial render here.
        await LoadContent();
        _ = this.RunSyncInBackgroundAsync();
    }

    private async Task RunSyncInBackgroundAsync()
    {
        try
        {
            await RunSync();
            await this.InvokeAsync(this.StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Background content sync failed");
        }
    }

    // Cached projection of contentItems for the current search/sort. Recomputed only when an
    // input changes (search text, sort column/direction, or the loaded list) rather than on
    // every render.
    private List<ContentItem> filteredItems = [];

    private List<ContentItem> FilteredItems => this.filteredItems;

    private void RecomputeFilteredItems()
    {
        if (this.contentItems == null)
        {
            this.filteredItems = [];
            return;
        }

        IEnumerable<ContentItem> query = this.contentItems;
        if (!string.IsNullOrWhiteSpace(this.searchTerm))
        {
            query = query.Where(c => c.Name.Contains(this.searchTerm, StringComparison.OrdinalIgnoreCase) || c.FileName.Contains(this.searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        query = (this.sortColumn, this.sortAscending) switch
        {
            ("Type", true) => query.OrderBy(c => c.Type).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase),
            ("Type", false) => query.OrderByDescending(c => c.Type).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase),
            ("FileName", true) => query.OrderBy(c => c.FileName, StringComparer.OrdinalIgnoreCase),
            ("FileName", false) => query.OrderByDescending(c => c.FileName, StringComparer.OrdinalIgnoreCase),
            ("Duration", true) => query.OrderBy(c => c.DurationSeconds),
            ("Duration", false) => query.OrderByDescending(c => c.DurationSeconds),
            ("Size", true) => query.OrderBy(c => c.FileSizeBytes),
            ("Size", false) => query.OrderByDescending(c => c.FileSizeBytes),
            ("Uploaded", true) => query.OrderBy(c => c.UploadedAt),
            ("Uploaded", false) => query.OrderByDescending(c => c.UploadedAt),
            (_, false) => query.OrderByDescending(c => c.Name, StringComparer.OrdinalIgnoreCase),
            _ => query.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
        };

        this.filteredItems = query.ToList();
    }

    private void SortBy(string column)
    {
        if (this.sortColumn == column)
        {
            this.sortAscending = !this.sortAscending;
        }
        else
        {
            this.sortColumn = column;
            this.sortAscending = true;
        }

        this.RecomputeFilteredItems();
    }

    private string SortIcon(string column)
    {
        if (this.sortColumn != column)
        {
            return "bi-arrow-down-up text-muted opacity-50";
        }

        return this.sortAscending ? "bi-sort-up" : "bi-sort-down";
    }

    private Task EnqueueYouTubeDownload()
    {
        if (string.IsNullOrWhiteSpace(this.youtubeUrl))
        {
            return Task.CompletedTask;
        }

        YouTubeDownloadJob job = new() { Url = this.youtubeUrl };
        YouTubeDownloadQueue.Enqueue(job);
        this.youtubeJobs.Add(new YouTubeJobState { JobId = job.Id, Url = this.youtubeUrl });
        this.youtubeUrl = "";

        if (!this.isPollingYouTube)
        {
            _ = this.PollYouTubeJobsAsync();
        }

        return Task.CompletedTask;
    }

    private async Task PollYouTubeJobsAsync()
    {
        if (this.isPollingYouTube)
        {
            return;
        }

        this.isPollingYouTube = true;
        try
        {
            while (this.youtubeJobs.Count(static j => j.Status is "Queued" or "Processing") != 0 && !cts.IsCancellationRequested)
            {
                await Task.Delay(2000, cts.Token);

                bool anyFinished = false;
                foreach (YouTubeJobState jobState in this.youtubeJobs.Where(static j => j.Status is "Queued" or "Processing").ToList())
                {
                    YouTubeDownloadJob? job = YouTubeDownloadQueue.GetJob(jobState.JobId);
                    if (job == null)
                    {
                        continue;
                    }

                    jobState.Status = job.Status.ToString();
                    jobState.Error = job.Error;
                    jobState.DownloadedTitle = job.DownloadedTitle;
                    if (job.Status is YouTubeDownloadJobStatus.Done or YouTubeDownloadJobStatus.Failed)
                    {
                        anyFinished = true;
                    }
                }

                if (anyFinished)
                {
                    await LoadContent();
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            /* expected during shutdown */
        }
        finally
        {
            this.isPollingYouTube = false;
        }
    }

