@code {
    private sealed class RenderJobState
    {
        public string JobId { get; init; } = "";
        public string Url { get; init; } = "";
        public int DurationSeconds { get; init; }
        public string Status { get; set; } = "Queued";
        public string? Error { get; set; }
    }

    private sealed class YouTubeJobState
    {
        public string JobId { get; init; } = "";
        public string Url { get; init; } = "";
        public string Status { get; set; } = "Queued";
        public string? Error { get; set; }
        public string? DownloadedTitle { get; set; }
    }

    private sealed class SvdJobState
    {
        public string JobId { get; init; } = "";
        public string SourceFileName { get; init; } = "";
        public string Status { get; set; } = "Queued";
        public string? Error { get; set; }
        public string? OutputFileName { get; set; }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task<bool> IsAdminAsync()
    {
        if (this.AuthState == null)
        {
            return false;
        }

        AuthenticationState state = await this.AuthState;
        return state.User.IsInRole("Admin");
    }

    private List<ContentItem>? contentItems;
    private string searchTerm = "";
    private string sortColumn = "Name";
    private bool sortAscending = true;
    private bool uploading;
    private bool syncing;
    private IBrowserFile? selectedFile;
    private bool stripAudio;
    private bool compressVideo;
    private string? uploadError;
    private string renderUrl = "";
    private int renderDuration = 30;
    private string? renderSubmitError;
    private string? syncMessage;
    private readonly List<RenderJobState> renderJobs = [];
    private bool isPolling;
    private ContentItem? previewItem;
    private ContentItem? processingItem;
    private bool isProcessingExisting;
    private ContentItem? renamingItem;
    private string newName = "";
    private string newFileName = "";
    private int newDuration = 10;
    private string companionContentItemId = "";
    private string companionPosition = "After";
    private ContentItem? itemToDelete;
    private string youtubeUrl = "";
    private readonly List<YouTubeJobState> youtubeJobs = [];
    private bool isPollingYouTube;
    private ContentItem? svdItem;
    private int svdMotionBucketId = 127;
    private readonly List<SvdJobState> svdJobs = [];
    private bool isPollingSvd;
    private ContentItem? kenBurnsItem;
    private double kbStartX;
    private double kbStartY;
    private double kbStartW = 100;
    private double kbEndX = 10;
    private double kbEndY = 10;
    private double kbEndW = 80;
    private int kbDuration = 10;
    private string kbOverlayId = "";
    private double kbParallaxRate;
    private bool kbProcessing;
    private string? kbError;
    private int kbImgW;
    private int kbImgH;
    private ContentItem? editItem;
    private double evStart;
    private double evEnd;
    private int evCropLeft;
    private int evCropRight;
    private int evCropTop;
    private int evCropBottom;
    private int evVidW;
    private int evVidH;
    private int evDuration;
    private bool evProcessing;
    private string? evError;
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        // Render from the database first so the page paints immediately,
        // then reconcile with the SMB folder in the background. The
        // ContentSyncWorkerService also syncs periodically, so a slow or
        // unmounted share never blocks the initial render here.
        await LoadContent();
        _ = this.RunSyncInBackgroundAsync();
    }

    private async Task RunSyncInBackgroundAsync()
    {
        try
        {
            await RunSync();
            await this.InvokeAsync(this.StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Background content sync failed");
        }
    }

    // Cached projection of contentItems for the current search/sort. Recomputed only when an
    // input changes (search text, sort column/direction, or the loaded list) rather than on
    // every render.
    private List<ContentItem> filteredItems = [];

    private List<ContentItem> FilteredItems => this.filteredItems;

    private void RecomputeFilteredItems()
    {
        if (this.contentItems == null)
        {
            this.filteredItems = [];
            return;
        }

        IEnumerable<ContentItem> query = this.contentItems;
        if (!string.IsNullOrWhiteSpace(this.searchTerm))
        {
            query = query.Where(c => c.Name.Contains(this.searchTerm, StringComparison.OrdinalIgnoreCase) || c.FileName.Contains(this.searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        query = (this.sortColumn, this.sortAscending) switch
        {
            ("Type", true) => query.OrderBy(c => c.Type).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase),
            ("Type", false) => query.OrderByDescending(c => c.Type).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase),
            ("FileName", true) => query.OrderBy(c => c.FileName, StringComparer.OrdinalIgnoreCase),
            ("FileName", false) => query.OrderByDescending(c => c.FileName, StringComparer.OrdinalIgnoreCase),
            ("Duration", true) => query.OrderBy(c => c.DurationSeconds),
            ("Duration", false) => query.OrderByDescending(c => c.DurationSeconds),
            ("Size", true) => query.OrderBy(c => c.FileSizeBytes),
            ("Size", false) => query.OrderByDescending(c => c.FileSizeBytes),
            ("Uploaded", true) => query.OrderBy(c => c.UploadedAt),
            ("Uploaded", false) => query.OrderByDescending(c => c.UploadedAt),
            (_, false) => query.OrderByDescending(c => c.Name, StringComparer.OrdinalIgnoreCase),
            _ => query.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
        };

        this.filteredItems = query.ToList();
    }

    private void SortBy(string column)
    {
        if (this.sortColumn == column)
        {
            this.sortAscending = !this.sortAscending;
        }
        else
        {
            this.sortColumn = column;
            this.sortAscending = true;
        }

        this.RecomputeFilteredItems();
    }

    private string SortIcon(string column)
    {
        if (this.sortColumn != column)
        {
            return "bi-arrow-down-up text-muted opacity-50";
        }

        return this.sortAscending ? "bi-sort-up" : "bi-sort-down";
    }

    private Task EnqueueYouTubeDownload()
    {
        if (string.IsNullOrWhiteSpace(this.youtubeUrl))
        {
            return Task.CompletedTask;
        }

        YouTubeDownloadJob job = new() { Url = this.youtubeUrl };
        YouTubeDownloadQueue.Enqueue(job);
        this.youtubeJobs.Add(new YouTubeJobState { JobId = job.Id, Url = this.youtubeUrl });
        this.youtubeUrl = "";

        if (!this.isPollingYouTube)
        {
            _ = this.PollYouTubeJobsAsync();
        }

        return Task.CompletedTask;
    }

    private async Task PollYouTubeJobsAsync()
    {
        if (this.isPollingYouTube)
        {
            return;
        }

        this.isPollingYouTube = true;
        try
        {
            while (this.youtubeJobs.Count(static j => j.Status is "Queued" or "Processing") != 0 && !cts.IsCancellationRequested)
            {
                await Task.Delay(2000, cts.Token);

                bool anyFinished = false;
                foreach (YouTubeJobState jobState in this.youtubeJobs.Where(static j => j.Status is "Queued" or "Processing").ToList())
                {
                    YouTubeDownloadJob? job = YouTubeDownloadQueue.GetJob(jobState.JobId);
                    if (job == null)
                    {
                        continue;
                    }

                    jobState.Status = job.Status.ToString();
                    jobState.Error = job.Error;
                    jobState.DownloadedTitle = job.DownloadedTitle;
                    if (job.Status is YouTubeDownloadJobStatus.Done or YouTubeDownloadJobStatus.Failed)
                    {
                        anyFinished = true;
                    }
                }

                if (anyFinished)
                {
                    await LoadContent();
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            /* expected during shutdown */
        }
        finally
        {
            this.isPollingYouTube = false;
        }
    }

    private void PreviewContent(ContentItem item)
    {
        previewItem = item;
    }

    private void ClosePreview()
    {
        previewItem = null;
    }

    private void StartProcessing(ContentItem item)
    {
        processingItem = item;
        stripAudio = false;
        compressVideo = false;
    }

    private async Task PerformProcessing()
    {
        if (processingItem == null || (!stripAudio && !compressVideo))
        {
            return;
        }

        isProcessingExisting = true;
        try
        {
            string folderPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
            
            string oldFileName = processingItem.FileName;
            string filePath = Path.Combine(folderPath, oldFileName);
            
            // Generate a unique temporary path for processing
            string tempFileName = $"{Guid.CreateVersion7():N}.tmp.mp4";
            string tempPath = Path.Combine(folderPath, tempFileName);

            if (!File.Exists(filePath))
            {
                Logger.LogError("Video file not found for processing: {FilePath}", filePath);
                return;
            }

            // Process the video to the temp MP4 file
            await VideoProcessorService.ProcessVideoAsync(filePath, tempPath, stripAudio, compressVideo, cancellationToken: cts.Token);

            // Determine the target file name (ensure it ends with .mp4 since we processed to MP4)
            string targetFileName = Path.ChangeExtension(oldFileName, ".mp4");
            string targetPath = Path.Combine(folderPath, targetFileName);

            // Clean up: delete original if it's different from target, then replace target with temp
            if (File.Exists(filePath)) File.Delete(filePath);
            if (File.Exists(targetPath) && targetPath != filePath) File.Delete(targetPath);
            
            File.Move(tempPath, targetPath);

            // Update database metadata
            int newDuration = await MediaMetadataService.GetVideoDurationAsync(targetPath);
            long newSize = new FileInfo(targetPath).Length;

            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            ContentItem? dbItem = await context.ContentItems.FindAsync(processingItem.Id);
            if (dbItem != null)
            {
                dbItem.FileName = targetFileName;
                dbItem.DurationSeconds = newDuration;
                dbItem.FileSizeBytes = newSize;
                await context.SaveChangesAsync();
            }
            await LoadContent();

            processingItem = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing existing video");
            uploadError = "Processing failed: " + ex.Message;
        }
        finally
        {
            isProcessingExisting = false;
        }
    }

    private void StartRename(ContentItem item)
    {
        this.renamingItem = item;
        this.newName = item.Name;
        this.newFileName = Path.GetFileNameWithoutExtension(item.FileName);
        this.newDuration = item.DurationSeconds;
        this.companionContentItemId = item.CompanionContentItemId?.ToString() ?? "";
        this.companionPosition = item.CompanionPosition?.ToString() ?? "After";
    }

    private void CancelRename()
    {
        renamingItem = null;
    }

    private async Task PerformRename()
    {
        if (renamingItem == null)
        {
            return;
        }

        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            ContentItem? item = await context.ContentItems.FindAsync(renamingItem.Id);
            if (item == null)
            {
                return;
            }

            string contentPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
            string oldFileName = item.FileName;
            string sanitizedInput = Path.GetFileName(newFileName);
            string oldExt = Path.GetExtension(oldFileName);
            string updatedFileName = sanitizedInput;
            if (!updatedFileName.EndsWith(oldExt, StringComparison.OrdinalIgnoreCase))
            {
                updatedFileName += oldExt;
            }

            if (updatedFileName != oldFileName)
            {
                string oldPath = Path.Combine(contentPath, oldFileName);
                string newPath = Path.Combine(contentPath, updatedFileName);

                if (File.Exists(oldPath))
                {
                    if (File.Exists(newPath))
                    {
                        uploadError = "A file with that name already exists on disk";
                        return;
                    }
                    File.Move(oldPath, newPath);
                }
                item.FileName = updatedFileName;
            }

            item.Name = newName;
            item.DurationSeconds = newDuration;

            // Guard against self-pairing (the UI hides the item itself, but never trust the posted value).
            if (int.TryParse(this.companionContentItemId, out int parsedCompanionId) && parsedCompanionId != item.Id)
            {
                item.CompanionContentItemId = parsedCompanionId;
                item.CompanionPosition = Enum.TryParse<CompanionPosition>(this.companionPosition, out CompanionPosition pos) ? pos : CompanionPosition.After;
            }
            else
            {
                item.CompanionContentItemId = null;
                item.CompanionPosition = null;
            }

            await context.SaveChangesAsync();

            renamingItem = null;
            await LoadContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error renaming content");
            uploadError = ex.Message;
        }
    }

    private void ConfirmDelete(ContentItem item)
    {
        itemToDelete = item;
    }

    private string GetVideoType(string fileName)
    {
        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".webm" => "video/webm",
            _ => "video/mp4"
        };
    }

    private async Task RunSync()
    {
        syncing = true;
        try
        {
            (int added, int removed, int updated) = await ContentSyncService.SyncAsync(cts.Token);
            if (added > 0 || removed > 0 || updated > 0)
                syncMessage = $"Folder sync: +{added} added, -{removed} removed, ~{updated} updated";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Content sync failed");
        }
        finally
        {
            syncing = false;
        }
        await LoadContent();
    }


    private async Task LoadContent()
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            contentItems = await context.ContentItems
                .OrderByDescending(c => c.UploadedAt)
                .ToListAsync(cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading content");
            contentItems = [];
        }

        this.RecomputeFilteredItems();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadError = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null)
        {
            return;
        }


        uploading = true;
        uploadError = null;
        try
        {
            const long maxAllowedSize = 512L * 1024 * 1024;
            string contentPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
            Directory.CreateDirectory(contentPath);

            string safeOriginalName = Path.GetFileName(selectedFile.Name);
            string fileName = $"{DateTime.UtcNow:yyyyMMddHHmmss}_{safeOriginalName}";
            string filePath = Path.Combine(contentPath, fileName);

            await using (Stream stream = selectedFile.OpenReadStream(maxAllowedSize))
            await using (FileStream fileStream = new(filePath, FileMode.Create))
            {
                await stream.CopyToAsync(fileStream);
            }

            ContentType contentType = selectedFile.ContentType.StartsWith("video/")
                ? ContentType.Video
                : ContentType.Image;

            int duration = 10;
            long finalSize = selectedFile.Size;
            if (contentType == ContentType.Video)
            {
                duration = await MediaMetadataService.GetVideoDurationAsync(filePath);
            }

            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            ContentItem? contentItem = await context.ContentItems.FirstOrDefaultAsync(i => i.FileName == fileName);

            if (contentItem == null)
            {
                contentItem = new ContentItem
                {
                    Name = Path.GetFileNameWithoutExtension(safeOriginalName),
                    FileName = fileName,
                    Type = contentType,
                    FileSizeBytes = finalSize,
                    DurationSeconds = duration,
                    UploadedAt = DateTime.UtcNow
                };
                context.ContentItems.Add(contentItem);
            }
            else
            {
                contentItem.Name = Path.GetFileNameWithoutExtension(safeOriginalName);
                contentItem.Type = contentType;
                contentItem.FileSizeBytes = finalSize;
                contentItem.DurationSeconds = duration;
            }

            if (contentType == ContentType.Video)
            {
                contentItem.ThumbnailFileName = await VideoProcessorService.TryCreateThumbnailAsync(filePath, contentPath);
            }
            else
            {
                contentItem.ThumbnailFileName = fileName;
            }

            await context.SaveChangesAsync();
            selectedFile = null;
            await LoadContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading file");
            uploadError = ex.Message;
        }
        finally
        {
            uploading = false;
        }
    }

    private Task SubmitRender()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(renderUrl))
            {
                return Task.CompletedTask;
            }


            renderSubmitError = null;
            try
            {
                if (renderDuration is < 5 or > 300)
                {
                    renderSubmitError = "Duration must be between 5 and 300 seconds";
                    return Task.CompletedTask;
                }

                string contentPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
                Directory.CreateDirectory(contentPath);

                string fileName = $"rendered_{DateTime.UtcNow:yyyyMMddHHmmss}_{Guid.CreateVersion7():N}.mp4";
                string outputPath = Path.Combine(contentPath, fileName);

                RenderJob job = new()
                {
                    Url = renderUrl,
                    DurationSeconds = renderDuration,
                    OutputPath = outputPath,
                    FileName = fileName
                };

                RenderQueue.Enqueue(job);
                renderJobs.Add(new RenderJobState { JobId = job.Id, Url = renderUrl, DurationSeconds = renderDuration });
                renderUrl = "";

                if (!isPolling)
                {
                    _ = PollAllJobsAsync();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error submitting render");
                renderSubmitError = ex.Message;
            }

            return Task.CompletedTask;
        }
        catch (Exception exception)
        {
            return Task.FromException(exception);
        }
    }

    private async Task PollAllJobsAsync()
    {
        if (isPolling)
        {
            return;
        }

        isPolling = true;
        try
        {
            while (renderJobs.Count(j => j.Status is "Queued" or "Processing") != 0 && !cts.IsCancellationRequested)
            {
                await Task.Delay(2000, cts.Token);

                bool anyFinished = false;
                foreach (RenderJobState jobState in renderJobs.Where(static j => j.Status is "Queued" or "Processing").ToList())
                {
                    RenderJob? job = RenderQueue.GetJob(jobState.JobId);
                    if (job == null)
                    {
                        continue;
                    }

                    jobState.Status = job.Status.ToString();
                    jobState.Error = job.Error;
                    if (job.Status is RenderJobStatus.Done or RenderJobStatus.Failed)
                    {
                        anyFinished = true;
                    }
                }

                if (anyFinished)
                {
                    await LoadContent();
                }
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            /* expected during shutdown */
        }
        finally
        {
            isPolling = false;
        }
    }

    private async Task DeleteContent(int id)
    {
        if (!await this.IsAdminAsync())
        {
            this.Logger.LogWarning("Non-admin user attempted to delete content {Id}", id);
            return;
        }

        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            ContentItem? item = await context.ContentItems.FindAsync(id);
            if (item != null)
            {
                string contentPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
                string filePath = Path.Combine(contentPath, item.FileName);
                
                if (File.Exists(filePath))
                {
                    File.Delete(filePath);
                }

                context.ContentItems.Remove(item);
                await context.SaveChangesAsync();
                itemToDelete = null;
                await LoadContent();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting content");
            uploadError = ex.Message;
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task StartKenBurnsAsync(ContentItem item)
    {
        this.kenBurnsItem = item;
        this.kbStartX = 0;
        this.kbStartY = 0;
        this.kbStartW = 100;
        this.kbEndX = 10;
        this.kbEndY = 10;
        this.kbEndW = 80;
        this.kbDuration = 10;
        this.kbOverlayId = "";
        this.kbParallaxRate = 0;
        this.kbProcessing = false;
        this.kbError = null;

        string contentPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
        string inputPath = Path.Combine(contentPath, item.FileName);
        try
        {
            (this.kbImgW, this.kbImgH) = await MediaMetadataService.GetVideoDimensionsAsync(inputPath, cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not determine image dimensions for Ken Burns preview; defaulting to 1920x1080");
            this.kbImgW = 1920;
            this.kbImgH = 1080;
        }
    }

    private void ClampKenBurnsRects()
    {
        this.kbStartX = Math.Clamp(this.kbStartX, 0, 99);
        this.kbStartY = Math.Clamp(this.kbStartY, 0, 99);
        this.kbStartW = Math.Clamp(this.kbStartW, 1, 100 - this.kbStartX);
        this.kbEndX = Math.Clamp(this.kbEndX, 0, 99);
        this.kbEndY = Math.Clamp(this.kbEndY, 0, 99);
        this.kbEndW = Math.Clamp(this.kbEndW, 1, 100 - this.kbEndX);
    }

    private async Task ApplyKenBurnsAsync()
    {
        if (this.kenBurnsItem == null)
        {
            return;
        }

        this.kbProcessing = true;
        this.kbError = null;
        try
        {
            string contentPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
            string inputPath = Path.Combine(contentPath, this.kenBurnsItem.FileName);

            string baseName = Path.GetFileNameWithoutExtension(this.kenBurnsItem.FileName);
            string outputFileName = $"{baseName}_kenburns_{DateTime.UtcNow:yyyyMMddHHmmss}.mp4";
            string outputPath = Path.Combine(contentPath, outputFileName);

            string? overlayPath = null;
            if (int.TryParse(this.kbOverlayId, out int overlayId))
            {
                ContentItem? overlayItem = this.contentItems?.FirstOrDefault(c => c.Id == overlayId && c.Type == ContentType.Image);
                if (overlayItem != null)
                {
                    string candidatePath = Path.Combine(contentPath, overlayItem.FileName);
                    if (File.Exists(candidatePath))
                    {
                        overlayPath = candidatePath;
                    }
                }
            }

            await VideoProcessorService.KenBurnsAsync(
                inputPath, outputPath, this.kbImgW, this.kbImgH,
                this.kbStartX / 100.0, this.kbStartY / 100.0, this.kbStartW / 100.0,
                this.kbEndX / 100.0, this.kbEndY / 100.0, this.kbEndW / 100.0,
                this.kbDuration, overlayPath, this.kbParallaxRate, cts.Token);

            long fileSize = new FileInfo(outputPath).Length;

            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync(cts.Token);
            ContentItem newItem = new()
            {
                Name = $"{this.kenBurnsItem.Name} (Ken Burns)",
                FileName = outputFileName,
                Type = ContentType.Video,
                FileSizeBytes = fileSize,
                DurationSeconds = this.kbDuration,
                UploadedAt = DateTime.UtcNow,
                SourceContentItemId = this.kenBurnsItem.Id,
                ThumbnailFileName = await VideoProcessorService.TryCreateThumbnailAsync(outputPath, contentPath, cts.Token)
            };
            context.ContentItems.Add(newItem);
            await context.SaveChangesAsync(cts.Token);

            this.kenBurnsItem = null;
            await LoadContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error applying Ken Burns");
            this.kbError = ex.Message;
        }
        finally
        {
            this.kbProcessing = false;
        }
    }

    private async Task StartEditAsync(ContentItem item)
    {
        this.editItem = item;
        this.evStart = 0;
        this.evCropLeft = 0;
        this.evCropRight = 0;
        this.evCropTop = 0;
        this.evCropBottom = 0;
        this.evProcessing = false;
        this.evError = null;

        string contentPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
        string inputPath = Path.Combine(contentPath, item.FileName);
        try
        {
            (this.evVidW, this.evVidH) = await MediaMetadataService.GetVideoDimensionsAsync(inputPath, cts.Token);
            this.evDuration = await MediaMetadataService.GetVideoDurationAsync(inputPath);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read video metadata for edit; using fallbacks");
            this.evVidW = 1920;
            this.evVidH = 1080;
            this.evDuration = item.DurationSeconds;
        }

        this.evEnd = this.evDuration;
    }

    private async Task ApplyEditAsync()
    {
        if (this.editItem == null)
        {
            return;
        }

        if (this.evEnd <= this.evStart)
        {
            this.evError = "End must be greater than start.";
            return;
        }

        if (this.evCropLeft + this.evCropRight >= this.evVidW || this.evCropTop + this.evCropBottom >= this.evVidH)
        {
            this.evError = "Crop amounts leave no visible area.";
            return;
        }

        this.evProcessing = true;
        this.evError = null;
        try
        {
            string contentPath = MediaPathResolver.Resolve(Configuration["ContentPath"] ?? "/mnt/plainsight/content");
            string inputPath = Path.Combine(contentPath, this.editItem.FileName);

            string baseName = Path.GetFileNameWithoutExtension(this.editItem.FileName);
            string outputFileName = $"{baseName}_edit_{DateTime.UtcNow:yyyyMMddHHmmss}.mp4";
            string outputPath = Path.Combine(contentPath, outputFileName);

            double? endSeconds = this.evEnd < this.evDuration ? this.evEnd : null;

            await VideoProcessorService.TrimAndCropAsync(
                inputPath, outputPath, this.evStart, endSeconds, this.evVidW, this.evVidH,
                this.evCropLeft, this.evCropRight, this.evCropTop, this.evCropBottom, cts.Token);

            long fileSize = new FileInfo(outputPath).Length;
            int newDuration = (int)Math.Round(this.evEnd - this.evStart);

            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync(cts.Token);
            ContentItem newItem = new()
            {
                Name = $"{this.editItem.Name} (Edited)",
                FileName = outputFileName,
                Type = ContentType.Video,
                FileSizeBytes = fileSize,
                DurationSeconds = newDuration,
                UploadedAt = DateTime.UtcNow,
                SourceContentItemId = this.editItem.Id,
                ThumbnailFileName = await VideoProcessorService.TryCreateThumbnailAsync(outputPath, contentPath, cts.Token)
            };
            context.ContentItems.Add(newItem);
            await context.SaveChangesAsync(cts.Token);

            this.editItem = null;
            await LoadContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error editing video");
            this.evError = ex.Message;
        }
        finally
        {
            this.evProcessing = false;
        }
    }

    private void StartSvdGeneration(ContentItem item)
    {
        this.svdItem = item;
        this.svdMotionBucketId = SvdOptions.Value.MotionBucketId;
    }

    private Task EnqueueSvdGeneration()
    {
        if (this.svdItem == null)
        {
            return Task.CompletedTask;
        }

        SvdGenerationJob job = new()
        {
            SourceContentItemId = this.svdItem.Id,
            SourceFileName = this.svdItem.FileName,
            MotionBucketId = this.svdMotionBucketId
        };
        SvdGenerationQueue.Enqueue(job);
        this.svdJobs.Add(new SvdJobState { JobId = job.Id, SourceFileName = this.svdItem.FileName });
        this.svdItem = null;

        if (!this.isPollingSvd)
        {
            _ = this.PollSvdJobsAsync();
        }

        return Task.CompletedTask;
    }

    private async Task PollSvdJobsAsync()
    {
        if (this.isPollingSvd)
        {
            return;
        }

        this.isPollingSvd = true;
        try
        {
            while (this.svdJobs.Count(static j => j.Status is "Queued" or "Processing") != 0 && !cts.IsCancellationRequested)
            {
                await Task.Delay(5000, cts.Token);

                bool anyFinished = false;
                foreach (SvdJobState jobState in this.svdJobs.Where(static j => j.Status is "Queued" or "Processing").ToList())
                {
                    SvdGenerationJob? job = SvdGenerationQueue.GetJob(jobState.JobId);
                    if (job == null)
                    {
                        continue;
                    }

                    jobState.Status = job.Status.ToString();
                    jobState.Error = job.Error;
                    jobState.OutputFileName = job.OutputFileName;
                    if (job.Status is SvdJobStatus.Done or SvdJobStatus.Failed)
                    {
                        anyFinished = true;
                    }
                }

                if (anyFinished)
                {
                    await LoadContent();
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            /* expected during shutdown */
        }
        finally
        {
            this.isPollingSvd = false;
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
