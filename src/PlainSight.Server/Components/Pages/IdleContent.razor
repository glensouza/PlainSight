@page "/idle-content"
@rendermode InteractiveServer
@attribute [Authorize]
@inject MediaMetadataService MediaMetadataService
@inject VideoProcessorService VideoProcessorService
@inject IConfiguration Configuration
@inject ILogger<IdleContent> Logger

@implements IDisposable

<PageTitle>Idle Content Library — PlainSight</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h1>Idle Content Library</h1>
        <p class="text-muted mb-0">Manage files played when no schedules are active (fallback content)</p>
    </div>
    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadIdleContent">
        <i class="bi bi-arrow-repeat"></i>
        <span> Refresh folder</span>
    </button>
</div>

<div class="row mb-4 mt-3">
    <div class="col-md-12">
        <div class="card border-info">
            <div class="card-header bg-info bg-opacity-10 text-info">
                <h5 class="mb-0 fs-6"><i class="bi bi-cloud-upload"></i> Upload Idle Content</h5>
            </div>
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-md-8">
                        <label class="form-label small fw-bold">Select Video or Image</label>
                        <InputFile class="form-control form-control-sm" accept="video/*,image/*" OnChange="HandleIdleFileSelected" />
                        <small class="text-muted">Will be played in alphabetical order — max 500 MB</small>
                    </div>
                    <div class="col-md-4">
                        @if (idleUploadError != null)
                        {
                            <div class="alert alert-danger py-1 px-2 mb-2 small">
                                <i class="bi bi-exclamation-triangle"></i> @idleUploadError
                            </div>
                        }
                        <button class="btn btn-info text-white w-100 btn-sm" @onclick="UploadIdleFile" disabled="@(uploadingIdle || selectedIdleFile == null)">
                            @if (uploadingIdle)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Uploading...</span>
                            }
                            else
                            {
                                <i class="bi bi-upload"></i>
                                <span>Upload to Idle Folder</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (idleFiles == null)
{
    <p><em>Loading idle library...</em></p>
}
else if (idleFiles.Count == 0)
{
    <div class="alert alert-light border shadow-sm">
        <i class="bi bi-info-circle"></i> No idle content found. Upload branded videos or images to ensure screens are never blank.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover border">
            <thead class="table-light">
                <tr>
                    <th>File Name</th>
                    <th>Size</th>
                    <th>Last Modified</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FileInfo file in idleFiles)
                {
                    <tr>
                        <td><code>@file.Name</code></td>
                        <td>@FormatFileSize(file.Length)</td>
                        <td>@file.LastWriteTimeUtc.ToLocalString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" @onclick="() => PreviewIdleContent(file.Name)" title="Preview">
                                    <i class="bi bi-eye"></i>
                                </button>
                                @if (file.Extension.ToLowerInvariant() is ".mp4" or ".mov" or ".avi" or ".webm" or ".mkv")
                                {
                                    <button class="btn btn-outline-info" @onclick="() => StartIdleProcessing(file.Name)" title="Process Video">
                                        <i class="bi bi-gear"></i>
                                    </button>
                                }
                                <button class="btn btn-outline-secondary" @onclick="() => StartIdleRename(file.Name)" title="Rename">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger" @onclick="() => idleFileToDelete = file.Name" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (idleFileToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog shadow-lg">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fs-6">Confirm Delete Idle File</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => idleFileToDelete = null"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete <strong>@idleFileToDelete</strong> from the idle folder?</p>
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => idleFileToDelete = null">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteIdleFile(idleFileToDelete)">Delete Permanently</button>
                </div>
            </div>
        </div>
    </div>
}

@if (renamingIdleFileName != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rename Idle File</h5>
                    <button type="button" class="btn-close" @onclick="CancelRename"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">File Name (on disk)</label>
                        <input type="text" class="form-control" @bind="newFileName" />
                        <small class="text-muted">Extension will be preserved automatically.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelRename">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="PerformIdleRename">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

@if (processingIdleFileName != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Process Video: @processingIdleFileName</h5>
                    <button type="button" class="btn-close" @onclick="() => processingIdleFileName = null"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Choose options to modify this video file. This will replace the existing file.</p>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="procStripAudio" @bind="stripAudio" />
                            <label class="form-check-label" for="procStripAudio">
                                Strip Audio
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="procCompressVideo" @bind="compressVideo" />
                            <label class="form-check-label" for="procCompressVideo">
                                Smaller File Size (Compression)
                            </label>
                        </div>
                    </div>
                    @if (isProcessingExisting)
                    {
                        <div class="alert alert-info py-2">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            Processing video... please wait.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => processingIdleFileName = null" disabled="@isProcessingExisting">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="PerformProcessing" disabled="@(isProcessingExisting || (!stripAudio && !compressVideo))">
                        Process and Replace
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (previewIdleFileName != null)
{
    string previewName = previewIdleFileName;
    string apiPath = $"/api/media/idle/{previewIdleFileName}";
    bool isImage = previewIdleFileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || previewIdleFileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || previewIdleFileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase);
    long fileSize = idleFiles?.FirstOrDefault(f => f.Name == previewIdleFileName)?.Length ?? 0;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.8);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header py-2">
                    <h6 class="modal-title text-truncate">@previewName</h6>
                    <button type="button" class="btn-close" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body p-0 bg-dark d-flex align-items-center justify-content-center" style="min-height: 400px;">
                    @if (isImage)
                    {
                        <img src="@apiPath" class="img-fluid" style="max-height: 70vh;" alt="@previewName"/>
                    }
                    else
                    {
                        <video controls autoplay class="w-100" style="max-height: 70vh;">
                            <source src="@apiPath" type="@GetVideoType(previewIdleFileName)" />
                            Your browser does not support the video tag.
                        </video>
                    }
                </div>
                <div class="modal-footer py-1">
                    <small class="text-muted">@previewIdleFileName (@FormatFileSize(fileSize))</small>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FileInfo>? idleFiles;
    private bool uploadingIdle;
    private IBrowserFile? selectedIdleFile;
    private bool stripAudio;
    private bool compressVideo;
    private string? idleUploadError;
    private string? processingIdleFileName;
    private bool isProcessingExisting;
    private string? previewIdleFileName;
    private string? renamingIdleFileName;
    private string newFileName = "";
    private string? idleFileToDelete;
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadIdleContent();
    }

    private void PreviewIdleContent(string fileName)
    {
        previewIdleFileName = fileName;
    }

    private void ClosePreview()
    {
        previewIdleFileName = null;
    }

    private void StartIdleProcessing(string fileName)
    {
        processingIdleFileName = fileName;
        stripAudio = false;
        compressVideo = false;
    }

    private async Task PerformProcessing()
    {
        if (processingIdleFileName == null || (!stripAudio && !compressVideo))
        {
            return;
        }

        isProcessingExisting = true;
        try
        {
            string idlePath = Configuration["IdlePath"] ?? "/mnt/plainsight/idle";
            string oldFileName = processingIdleFileName;
            string filePath = Path.Combine(idlePath, oldFileName);
            
            string tempFileName = $"{Guid.CreateVersion7():N}.tmp.mp4";
            string tempPath = Path.Combine(idlePath, tempFileName);

            if (!File.Exists(filePath))
            {
                Logger.LogError("Video file not found for processing: {FilePath}", filePath);
                return;
            }

            await VideoProcessorService.ProcessVideoAsync(filePath, tempPath, stripAudio, compressVideo, cts.Token);

            string targetFileName = Path.ChangeExtension(oldFileName, ".mp4");
            string targetPath = Path.Combine(idlePath, targetFileName);

            if (File.Exists(filePath)) File.Delete(filePath);
            if (File.Exists(targetPath) && targetPath != filePath) File.Delete(targetPath);
            
            File.Move(tempPath, targetPath);

            processingIdleFileName = null;
            await LoadIdleContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing idle video");
            idleUploadError = "Processing failed: " + ex.Message;
        }
        finally
        {
            isProcessingExisting = false;
        }
    }

    private void StartIdleRename(string fileName)
    {
        renamingIdleFileName = fileName;
        newFileName = Path.GetFileNameWithoutExtension(fileName);
    }

    private void CancelRename()
    {
        renamingIdleFileName = null;
    }

    private async Task PerformIdleRename()
    {
        if (renamingIdleFileName == null)
        {
            return;
        }

        try
        {
            string idlePath = Configuration["IdlePath"] ?? "/mnt/plainsight/idle";
            string oldFileName = renamingIdleFileName;
            string sanitizedInput = Path.GetFileName(newFileName);
            string oldExt = Path.GetExtension(oldFileName);
            string updatedFileName = sanitizedInput;
            if (!updatedFileName.EndsWith(oldExt, StringComparison.OrdinalIgnoreCase))
            {
                updatedFileName += oldExt;
            }

            if (updatedFileName != oldFileName)
            {
                string oldPath = Path.Combine(idlePath, oldFileName);
                string newPath = Path.Combine(idlePath, updatedFileName);

                if (File.Exists(oldPath))
                {
                    if (File.Exists(newPath))
                    {
                        idleUploadError = "A file with that name already exists in the idle folder";
                        return;
                    }
                    File.Move(oldPath, newPath);
                }
            }

            renamingIdleFileName = null;
            await LoadIdleContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error renaming idle content");
            idleUploadError = ex.Message;
        }
    }

    private static string GetVideoType(string fileName)
    {
        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".webm" => "video/webm",
            _ => "video/mp4"
        };
    }

    private Task LoadIdleContent()
    {
        try
        {
            try
            {
                string idlePath = Configuration["IdlePath"] ?? "/mnt/plainsight/idle";
                if (!Directory.Exists(idlePath))
                {
                    Directory.CreateDirectory(idlePath);
                }

                idleFiles = new DirectoryInfo(idlePath)
                    .GetFiles()
                    .Where(f => MediaConstants.IsSupported(f.Name))
                    .OrderBy(f => f.Name)
                    .ToList();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading idle content");
                idleFiles = [];
            }

            return Task.CompletedTask;
        }
        catch (Exception exception)
        {
            return Task.FromException(exception);
        }
    }

    private void HandleIdleFileSelected(InputFileChangeEventArgs e)
    {
        selectedIdleFile = e.File;
        idleUploadError = null;
    }

    private async Task UploadIdleFile()
    {
        if (selectedIdleFile == null)
        {
            return;
        }

        uploadingIdle = true;
        idleUploadError = null;
        try
        {
            const long maxAllowedSize = 512L * 1024 * 1024;
            string idlePath = Configuration["IdlePath"] ?? "/mnt/plainsight/idle";
            Directory.CreateDirectory(idlePath);

            string safeOriginalName = Path.GetFileName(selectedIdleFile.Name);
            string filePath = Path.Combine(idlePath, safeOriginalName);

            if (File.Exists(filePath))
            {
                idleUploadError = "A file with this name already exists in the idle folder.";
                return;
            }

            await using (Stream stream = selectedIdleFile.OpenReadStream(maxAllowedSize))
            await using (FileStream fileStream = new(filePath, FileMode.Create))
            {
                await stream.CopyToAsync(fileStream);
            }

            selectedIdleFile = null;
            await LoadIdleContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading idle file");
            idleUploadError = ex.Message;
        }
        finally
        {
            uploadingIdle = false;
        }
    }

    private async Task DeleteIdleFile(string fileName)
    {
        try
        {
            string idlePath = Configuration["IdlePath"] ?? "/mnt/plainsight/idle";
            string filePath = Path.Combine(idlePath, fileName);

            if (File.Exists(filePath))
            {
                File.Delete(filePath);
            }

            idleFileToDelete = null;
            await LoadIdleContent();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting idle content");
            idleUploadError = ex.Message;
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
