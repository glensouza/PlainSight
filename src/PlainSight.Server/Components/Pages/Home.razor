@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<PlainSightDbContext> DbFactory
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@using PlainSight.Server.Services

<PageTitle>PlainSight — Overview</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h1>Overview</h1>
        <p class="text-muted mb-0">
            PlainSight digital signage control panel
            <span class="badge bg-light text-dark border ms-2">
                <i class="bi bi-clock me-1"></i>
                @DateTime.UtcNow.ToLocal().ToString("HH:mm") (@TimeExtensions.GetTimeZoneName())
            </span>
        </p>
    </div>
    <span class="badge bg-success px-3 py-2">
        <i class="bi bi-broadcast me-1"></i> Live
    </span>
</div>

<!-- Dashboard Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <a href="/devices" class="text-decoration-none">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-card-icon" style="background: var(--ps-blue-dim); color: var(--ps-blue); border-color: rgba(59, 130, 246, 0.25);">
                        <i class="bi bi-display"></i>
                    </div>
                    <div>
                        <div class="stat-card-value">@(this.onlineCount?.ToString() ?? "—")</div>
                        <div class="stat-card-label">Online Devices</div>
                    </div>
                </div>
                <p class="stat-card-description mb-0">Monitor your fleet in real-time. View status, version, and what's playing.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a href="/content" class="text-decoration-none">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-card-icon" style="background: var(--ps-online-dim); color: var(--ps-online); border-color: rgba(16, 185, 129, 0.25);">
                        <i class="bi bi-film"></i>
                    </div>
                    <div>
                        <div class="stat-card-value">@(this.contentCount?.ToString() ?? "—")</div>
                        <div class="stat-card-label">Content Items</div>
                    </div>
                </div>
                <p class="stat-card-description mb-0">Upload videos and images, or render websites to video.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a href="/playlists" class="text-decoration-none">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-card-icon" style="background: rgba(147, 51, 234, 0.16); color: #a855f7; border-color: rgba(147, 51, 234, 0.25);">
                        <i class="bi bi-collection-play"></i>
                    </div>
                    <div>
                        <div class="stat-card-value">@(this.playlistCount?.ToString() ?? "—")</div>
                        <div class="stat-card-label">Playlists</div>
                    </div>
                </div>
                <p class="stat-card-description mb-0">Organize content into playlists and assign them to device groups.</p>
            </div>
        </a>
    </div>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="col-md-6 col-lg-3">
                <a href="/versions" class="text-decoration-none">
                    <div class="stat-card h-100">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="stat-card-icon" style="background: var(--ps-warn-dim); color: var(--ps-warn); border-color: rgba(245, 158, 11, 0.25);">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div>
                                <div class="stat-card-value">@(this.versionCount?.ToString() ?? "—")</div>
                                <div class="stat-card-label">Versions</div>
                            </div>
                        </div>
                        <p class="stat-card-description mb-0">Upload player binaries and run canary deployments by device group.</p>
                    </div>
                </a>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

<div class="row g-3">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="col-md-6 col-lg-3">
                <a href="/scalar/v1" target="_blank" class="text-decoration-none">
                    <div class="stat-card h-100">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="stat-card-icon" style="background: var(--ps-bg-3); color: var(--ps-text-2); border-color: var(--ps-line-strong);">
                                <i class="bi bi-braces"></i>
                            </div>
                            <div>
                                <div class="stat-card-value scalar-value">Scalar</div>
                                <div class="stat-card-label">API Reference</div>
                            </div>
                        </div>
                        <p class="stat-card-description mb-0">Explore the PlainSight API using the interactive Scalar documentation.</p>
                    </div>
                </a>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private int? onlineCount;
    private int? contentCount;
    private int? playlistCount;
    private int? versionCount;

    protected override async Task OnInitializedAsync()
    {
        await this.LoadStats();
    }

    private async Task LoadStats()
    {
        try
        {
            await using PlainSightDbContext context = await this.DbFactory.CreateDbContextAsync();
            
            DateTime onlineThreshold = DateTime.UtcNow.AddSeconds(-60);
            this.onlineCount = await context.Devices.CountAsync(d => d.LastSeen >= onlineThreshold);
            this.contentCount = await context.ContentItems.CountAsync();
            this.playlistCount = await context.Playlists.CountAsync();
            this.versionCount = await context.PlayerVersions.CountAsync();
        }
        catch (Exception ex)
        {
            this.Logger.LogWarning(ex, "Failed to load overview statistics");
            this.onlineCount = 0;
            this.contentCount = 0;
            this.playlistCount = 0;
            this.versionCount = 0;
        }
    }
}
