@page "/devices"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<PlainSightDbContext> DbFactory
@inject ILogger<Devices> Logger
@inject IHttpClientFactory HttpClientFactory
@implements IDisposable

<PageTitle>Devices — PlainSight</PageTitle>

<div class="page-header">
    <h1>Devices</h1>
    <p class="text-muted mb-0">Monitor and manage your digital signage fleet</p>
</div>

@if (bulkResultMessage != null)
{
    <div class="alert @(bulkResultIsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
        @bulkResultMessage
        <button type="button" class="btn-close" @onclick="DismissBulkResult"></button>
    </div>
}

@if (devices == null)
{
    <p><em>Loading devices...</em></p>
}
else if (!devices.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No devices registered yet. Devices will appear here once they send their first heartbeat.
    </div>
}
else
{
    <div class="ps-toolbar">
        <div class="ps-toolbar__filters">
            <button class="ps-filter @(statusFilter == "all" ? "is-active" : "")" @onclick='() => SetFilter("all")'>
                All <span class="ps-filter__count">@devices.Count</span>
            </button>
            <button class="ps-filter ps-filter--online @(statusFilter == "online" ? "is-active" : "")" @onclick='() => SetFilter("online")'>
                <span class="ps-led"></span> Online <span class="ps-filter__count">@OnlineCount</span>
            </button>
            <button class="ps-filter ps-filter--warn @(statusFilter == "warn" ? "is-active" : "")" @onclick='() => SetFilter("warn")'>
                <span class="ps-led"></span> Degraded <span class="ps-filter__count">@WarnCount</span>
            </button>
            <button class="ps-filter ps-filter--offline @(statusFilter == "offline" ? "is-active" : "")" @onclick='() => SetFilter("offline")'>
                <span class="ps-led"></span> Offline <span class="ps-filter__count">@OfflineCount</span>
            </button>
        </div>
        <div class="ps-toolbar__actions">
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleSelectAllVisible" title="Select all visible">
                <i class="bi bi-check2-square"></i>
                @(AllVisibleSelected ? "Deselect all" : "Select all")
            </button>
            <button class="btn btn-sm btn-primary" @onclick="LoadDevices">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <div class="ps-grid @(selectedDeviceIds.Count > 0 ? "ps-grid--bulk-active" : "")">
        @foreach (Device device in FilteredDevices())
        {
            bool isOnline = IsDeviceOnline(device.LastSeen);
            string statusKey = GetStatusKey(device.LastSeen);
            bool isSelected = selectedDeviceIds.Contains(device.DeviceId);
            <div class="ps-tile ps-tile--@statusKey @(isSelected ? "is-selected" : "")">
                <div class="ps-tile__rail"></div>

                <header class="ps-tile__head">
                    <label class="ps-tile__check" @onclick:stopPropagation>
                        <input type="checkbox"
                               checked="@isSelected"
                               @onchange="e => ToggleDevice(device.DeviceId, (bool)(e.Value ?? false))" />
                    </label>
                    <div class="ps-tile__ident">
                        <div class="ps-tile__name" title="@device.Name">@device.Name</div>
                        <div class="ps-tile__id"><code>@device.DeviceId</code></div>
                    </div>
                    <span class="pill pill--@statusKey">
                        <span class="led @(isOnline ? "led-pulse" : "")"></span>
                        @GetStatusLabel(statusKey)
                    </span>
                </header>

                <div class="ps-tile__screen">
                    @if (device.LatestScreenshotAt.HasValue && !string.IsNullOrEmpty(device.LatestScreenshotPath))
                    {
                        <button class="ps-tile__screen-btn"
                                @onclick="() => ShowScreenshotHistory(device)"
                                title="View screenshot history">
                            <img src="/api/media/screenshot/@device.DeviceId/@(Path.GetFileName(device.LatestScreenshotPath))?t=@previewCacheBust" alt="" />
                        </button>
                    }
                    else
                    {
                        <div class="ps-tile__screen-empty">
                            <i class="bi bi-image-alt"></i>
                            <span>NO SCREENSHOT</span>
                        </div>
                    }
                    @if (!isOnline)
                    {
                        <div class="ps-tile__nosignal">
                            <span>NO SIGNAL</span>
                        </div>
                    }
                    @if (IsLiveModeActive(device) && isOnline)
                    {
                        <div class="ps-tile__live">
                            <span class="led led-pulse"></span> LIVE · NDI
                        </div>
                    }
                    <div class="ps-tile__playing" title="@(device.CurrentlyPlaying ?? "")">
                        @(device.CurrentlyPlaying ?? "—")
                    </div>
                </div>

                <div class="ps-tile__telemetry">
                    <div class="ps-cell">
                        <div class="ps-cell__label">LAST SEEN</div>
                        <div class="ps-cell__value" title="@device.LastSeen.ToLocalString()">
                            @GetTimeSince(device.LastSeen)
                        </div>
                    </div>
                    <div class="ps-cell">
                        <div class="ps-cell__label">VERSION</div>
                        <div class="ps-cell__value mono">@device.CurrentVersion</div>
                    </div>
                    <div class="ps-cell">
                        <div class="ps-cell__label">GROUP</div>
                        <div class="ps-cell__value">
                            <select class="ps-cell__select"
                                    value="@device.Group"
                                    @onchange="e => ChangeGroup(device.DeviceId, e.Value?.ToString() ?? device.Group)">
                                @if (deviceGroups != null)
                                {
                                    @foreach (DeviceGroup g in deviceGroups)
                                    {
                                        <option value="@g.Name">@g.Name</option>
                                    }
                                }
                                else
                                {
                                    <option value="@device.Group">@device.Group</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="ps-cell">
                        <div class="ps-cell__label">SCREENSHOT</div>
                        <div class="ps-cell__value">
                            @if (device.LatestScreenshotAt.HasValue)
                            {
                                @GetTimeSince(device.LatestScreenshotAt.Value)
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </div>
                    </div>
                </div>

                <footer class="ps-tile__actions">
                    <button class="ps-action"
                            @onclick="() => RequestScreenshot(device.DeviceId)"
                            disabled="@(!isOnline || requestingScreenshot.Contains(device.DeviceId))"
                            title="Capture screenshot">
                        @if (requestingScreenshot.Contains(device.DeviceId))
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-camera"></i>
                        }
                        <span>Capture</span>
                    </button>
                    <button class="ps-action"
                            @onclick="() => OpenLiveModeEditor(device)"
                            title="Configure live (NDI) mode">
                        <i class="bi bi-broadcast"></i>
                        <span>@GetLiveModeLabel(device)</span>
                    </button>
                    <button class="ps-action ps-action--warn"
                            @onclick="() => ResetApiKey(device.DeviceId)"
                            disabled="@resettingApiKey.Contains(device.DeviceId)"
                            title="Reset API key">
                        @if (resettingApiKey.Contains(device.DeviceId))
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-key"></i>
                        }
                        <span>Reset Key</span>
                    </button>
                </footer>
            </div>
        }
    </div>

    <div class="ps-grid-foot">
        <span class="text-muted"><i class="bi bi-arrow-clockwise"></i> Auto-refreshing every 5 seconds</span>
    </div>
}

@if (historyDevice != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="history-modal-title"
         style="background:rgba(4,8,14,0.7);"
         @onclick="CloseHistory"
         @onkeydown="HandleModalKeyDown">
        <div class="modal-dialog modal-xl modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="history-modal-title" class="modal-title">
                        Screenshot History — <code>@historyDevice.DeviceId</code>
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseHistory"></button>
                </div>
                <div class="modal-body">
                    @if (selectedScreenshot != null)
                    {
                        <div class="text-center mb-3 position-relative">
                            <img src="@selectedScreenshot.Url?t=@previewCacheBust"
                                 alt="Screenshot @selectedScreenshot.CapturedAt.ToLocalString()"
                                 class="img-fluid rounded"
                                 style="max-height:60vh;" />
                            <div class="mt-2 d-flex align-items-center justify-content-center gap-3">
                                <div class="text-muted small">
                                    <i class="bi bi-clock me-1"></i> @selectedScreenshot.CapturedAt.ToLocalString()
                                </div>
                                <button class="btn btn-sm btn-outline-danger" 
                                        @onclick="() => DeleteScreenshot(selectedScreenshot)"
                                        disabled="@isDeletingScreenshot">
                                    @if (isDeletingScreenshot)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-trash me-1"></i>
                                    }
                                    Delete
                                </button>
                            </div>
                        </div>
                    }
                    @if (screenshotHistory == null)
                    {
                        <p><em>Loading history...</em></p>
                    }
                    else if (!screenshotHistory.Any())
                    {
                        <p class="text-muted">No screenshot history available.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (DeviceScreenshotDto shot in screenshotHistory)
                            {
                                bool isSelectedShot = selectedScreenshot?.Id == shot.Id;
                                <button class="btn p-1 @(isSelectedShot ? "border border-info border-2" : "border")"
                                        @onclick="() => SelectScreenshot(shot)"
                                        title="@shot.CapturedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                    <img src="@shot.Url?t=@previewCacheBust"
                                         alt="@shot.CapturedAt.ToString("HH:mm:ss")"
                                         style="width:120px;height:68px;object-fit:cover;" />
                                    <div class="text-center" style="font-size:0.7rem;">
                                        @GetTimeSince(shot.CapturedAt)
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (liveModeDevice != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="live-mode-modal-title"
         style="background:rgba(4,8,14,0.7);"
         @onclick="CloseLiveModeEditor">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="live-mode-modal-title" class="modal-title">
                        Live Mode — <code>@liveModeDevice.DeviceId</code>
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseLiveModeEditor"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Manual override</label>
                        <select class="form-select" @bind="liveModeOverrideValue">
                            <option value="auto">Auto (follow NDI source presence)</option>
                            <option value="on">Force ON (always live)</option>
                            <option value="off">Force OFF (always signage)</option>
                        </select>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="auto-switch-check" @bind="liveModeAutoSwitch" />
                        <label class="form-check-label" for="auto-switch-check">
                            Auto-switch when assigned NDI source appears on the network
                        </label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assigned NDI source</label>
                        <select class="form-select" @bind="liveModeSourceId">
                            <option value="">— None —</option>
                            @if (ndiSources != null)
                            {
                                @foreach (NdiSource source in ndiSources)
                                {
                                    bool isFresh = (DateTime.UtcNow - source.LastSeenUtc).TotalSeconds < 60;
                                    <option value="@source.Id">
                                        @source.ServiceName @(isFresh ? "(online)" : "(offline)")
                                    </option>
                                }
                            }
                        </select>
                        <div class="form-text">
                            Only sources currently or recently broadcasting on the network appear here.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseLiveModeEditor">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveLiveMode" disabled="@isSavingLiveMode">
                        @if (isSavingLiveMode)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (selectedDeviceIds.Count > 0)
{
    <div class="bulk-action-bar">
        <div class="bulk-action-bar__info">
            <strong>@selectedDeviceIds.Count device(s) selected</strong>
            <button class="btn btn-sm btn-link p-0 ms-2" @onclick="ClearSelection">Clear</button>
        </div>

        <div class="bulk-action-bar__actions">
            <button class="btn btn-sm btn-primary"
                    @onclick="BulkScreenshot"
                    disabled="@isBulkScreenshotting"
                    title="Request screenshot from all selected devices">
                @if (isBulkScreenshotting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-camera"></i>
                }
                Screenshot (@selectedDeviceIds.Count)
            </button>

            <span class="bulk-action-bar__sep d-none d-md-inline">|</span>

            <div class="bulk-action-bar__group d-flex gap-2 align-items-center">
                <select class="form-select form-select-sm bulk-action-bar__select"
                        @bind="bulkGroupSelection">
                    <option value="">— Move to group —</option>
                    @foreach (DeviceGroup g in deviceGroups ?? [])
                    {
                        <option value="@g.Name">@g.Name</option>
                    }
                </select>
                <button class="btn btn-sm btn-secondary"
                        @onclick="BulkMoveGroup"
                        disabled="@(isBulkMovingGroup || string.IsNullOrEmpty(bulkGroupSelection))">
                    @if (isBulkMovingGroup)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    Move
                </button>
            </div>

            <span class="bulk-action-bar__sep d-none d-md-inline">|</span>

            <div class="bulk-action-bar__version d-flex gap-2 align-items-center">
                <select class="form-select form-select-sm bulk-action-bar__select"
                        @bind="bulkVersionGroup">
                    <option value="">— Group —</option>
                    @foreach (DeviceGroup g in deviceGroups ?? [])
                    {
                        <option value="@g.Name">@g.Name</option>
                    }
                </select>
                <select class="form-select form-select-sm bulk-action-bar__select"
                        @bind="bulkVersionSelection">
                    <option value="">— Version —</option>
                    @foreach (PlayerVersion v in playerVersions ?? [])
                    {
                        <option value="@v.VersionNumber">@v.VersionNumber</option>
                    }
                </select>
                <button class="btn btn-sm btn-warning"
                        @onclick="BulkAssignVersion"
                        disabled="@(isBulkAssigningVersion || string.IsNullOrEmpty(bulkVersionGroup) || string.IsNullOrEmpty(bulkVersionSelection))">
                    @if (isBulkAssigningVersion)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    Assign Version
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Device>? devices;
    private readonly HashSet<string> requestingScreenshot = [];
    private readonly HashSet<string> resettingApiKey = [];
    private readonly HashSet<string> selectedDeviceIds = [];
    private List<DeviceGroup>? deviceGroups;
    private List<PlayerVersion>? playerVersions;
    private List<NdiSource>? ndiSources;
    private Device? liveModeDevice;
    private string liveModeOverrideValue = "auto";
    private bool liveModeAutoSwitch;
    private string liveModeSourceId = string.Empty;
    private bool isSavingLiveMode;
    private Timer? refreshTimer;
    private Device? historyDevice;
    private List<DeviceScreenshotDto>? screenshotHistory;
    private DeviceScreenshotDto? selectedScreenshot;
    private string previewCacheBust = string.Empty;
    private bool isDeletingScreenshot;
    private string? bulkGroupSelection;
    private string? bulkVersionGroup;
    private string? bulkVersionSelection;
    private bool isBulkScreenshotting;
    private bool isBulkMovingGroup;
    private bool isBulkAssigningVersion;
    private string? bulkResultMessage;
    private bool bulkResultIsSuccess;
    private string statusFilter = "all";

    private int OnlineCount => devices?.Count(d => GetStatusKey(d.LastSeen) == "online") ?? 0;
    private int WarnCount => devices?.Count(d => GetStatusKey(d.LastSeen) == "warn") ?? 0;
    private int OfflineCount => devices?.Count(d => GetStatusKey(d.LastSeen) == "offline") ?? 0;

    private bool AllVisibleSelected
    {
        get
        {
            List<Device> visible = FilteredDevices().ToList();
            return visible.Count > 0 && visible.All(d => selectedDeviceIds.Contains(d.DeviceId));
        }
    }

    private IEnumerable<Device> FilteredDevices()
    {
        if (devices == null)
        {
            return [];
        }

        return statusFilter switch
        {
            "online"  => devices.Where(d => GetStatusKey(d.LastSeen) == "online"),
            "warn"    => devices.Where(d => GetStatusKey(d.LastSeen) == "warn"),
            "offline" => devices.Where(d => GetStatusKey(d.LastSeen) == "offline"),
            _         => devices
        };
    }

    private void SetFilter(string key) => statusFilter = key;

    private static string GetStatusKey(DateTime lastSeen)
    {
        double secs = (DateTime.UtcNow - lastSeen).TotalSeconds;
        return secs switch
        {
            < 60 => "online",
            < 300 => "warn",
            _ => "offline"
        };
    }

    private static string GetStatusLabel(string key) => key switch
    {
        "online"  => "ONLINE",
        "warn"    => "DEGRADED",
        _         => "OFFLINE"
    };

    private static bool IsLiveModeActive(Device device)
    {
        return device.LiveModeOverride switch
        {
            true => true,
            false => false,
            _ => device is { NdiAutoSwitch: true, AssignedNdiSourceId: not null }
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadDevices(),
            LoadGroupsAsync(),
            LoadVersionsAsync()
        );

        refreshTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                try
                {
                    await LoadDevices();
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error during auto-refresh of devices");
                }
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadDevices()
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            devices = await context.Devices
                .Include(d => d.AssignedNdiSource)
                .OrderByDescending(d => d.LastSeen)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading devices");
            devices = [];
        }
    }

    private async Task LoadNdiSourcesAsync()
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            ndiSources = await context.NdiSources
                .OrderBy(s => s.ServiceName)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading NDI sources");
            ndiSources = [];
        }
    }

    private static string GetLiveModeLabel(Device device)
    {
        return device.LiveModeOverride switch
        {
            true => "Forced ON",
            false => "Forced OFF",
            _ => device is { NdiAutoSwitch: true, AssignedNdiSourceId: not null } ? "Auto" : "Off"
        };
    }

    private async Task OpenLiveModeEditor(Device device)
    {
        liveModeDevice = device;
        liveModeAutoSwitch = device.NdiAutoSwitch;
        liveModeSourceId = device.AssignedNdiSourceId?.ToString() ?? string.Empty;
        liveModeOverrideValue = device.LiveModeOverride switch
        {
            true => "on",
            false => "off",
            null => "auto"
        };
        await LoadNdiSourcesAsync();
        StateHasChanged();
    }

    private void CloseLiveModeEditor() => liveModeDevice = null;

    private async Task SaveLiveMode()
    {
        if (liveModeDevice == null)
        {
            return;
        }

        isSavingLiveMode = true;
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Device? device = await context.Devices.FirstOrDefaultAsync(d => d.DeviceId == liveModeDevice.DeviceId);
            if (device == null)
            {
                return;
            }


            device.NdiAutoSwitch = liveModeAutoSwitch;
            device.AssignedNdiSourceId = int.TryParse(liveModeSourceId, out int parsedSourceId) ? parsedSourceId : null;
            device.LiveModeOverride = liveModeOverrideValue switch
            {
                "on" => true,
                "off" => false,
                _ => null
            };

            await context.SaveChangesAsync();
            await LoadDevices();
            CloseLiveModeEditor();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving live mode for device {DeviceId}", liveModeDevice.DeviceId);
        }
        finally
        {
            isSavingLiveMode = false;
            StateHasChanged();
        }
    }

    private async Task LoadGroupsAsync()
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            deviceGroups = await context.DeviceGroups.OrderBy(g => g.Name).ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading device groups");
            deviceGroups = [];
        }
    }

    private async Task LoadVersionsAsync()
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            playerVersions = await context.PlayerVersions.OrderByDescending(v => v.VersionNumber).ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading player versions");
            playerVersions = [];
        }
    }

    private async Task ChangeGroup(string deviceId, string newGroup)
    {
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Device? device = await context.Devices.FirstOrDefaultAsync(d => d.DeviceId == deviceId);
            if (device != null)
            {
                device.Group = newGroup;
                await context.SaveChangesAsync();
                await LoadDevices();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing group for device {DeviceId}", deviceId);
        }
    }

    private async Task RequestScreenshot(string deviceId)
    {
        requestingScreenshot.Add(deviceId);
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Device? device = await context.Devices.FirstOrDefaultAsync(d => d.DeviceId == deviceId);
            if (device != null && !string.IsNullOrEmpty(device.CallbackUrl))
            {
                HttpClient client = HttpClientFactory.CreateClient("player");
                HttpResponseMessage response = await client.PostAsync($"{device.CallbackUrl}/screenshot", null);
                if (response.IsSuccessStatusCode)
                {
                    Logger.LogInformation("Screenshot requested for device {DeviceId} via {CallbackUrl}", deviceId, device.CallbackUrl);
                    await LoadDevices();
                    Device? updated = devices?.FirstOrDefault(d => d.DeviceId == deviceId);
                    if (updated != null) await ShowScreenshotHistory(updated);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error requesting screenshot for device {DeviceId}", deviceId);
        }
        finally
        {
            requestingScreenshot.Remove(deviceId);
            StateHasChanged();
        }
    }

    private async Task ResetApiKey(string deviceId)
    {
        resettingApiKey.Add(deviceId);
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            Device? device = await context.Devices.FirstOrDefaultAsync(d => d.DeviceId == deviceId);
            if (device != null)
            {
                device.ApiKey = null;
                await context.SaveChangesAsync();
                Logger.LogInformation("API key reset for device {DeviceId}", deviceId);

                if (!string.IsNullOrEmpty(device.CallbackUrl))
                {
                    HttpClient client = HttpClientFactory.CreateClient("player");
                    await client.PostAsync($"{device.CallbackUrl}/reset-api-key", null);
                }

                await LoadDevices();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error resetting API key for device {DeviceId}", deviceId);
        }
        finally
        {
            resettingApiKey.Remove(deviceId);
            StateHasChanged();
        }
    }

    private void ToggleSelectAllVisible()
    {
        List<Device> visible = FilteredDevices().ToList();
        if (visible.Count == 0)
        {
            return;
        }

        if (visible.All(d => selectedDeviceIds.Contains(d.DeviceId)))
        {
            foreach (Device d in visible)
            {
                selectedDeviceIds.Remove(d.DeviceId);
            }
        }
        else
        {
            foreach (Device d in visible)
            {
                selectedDeviceIds.Add(d.DeviceId);
            }
        }
    }

    private void ToggleDevice(string deviceId, bool value)
    {
        if (value)
        {
            selectedDeviceIds.Add(deviceId);
        }
        else
        {
            selectedDeviceIds.Remove(deviceId);
        }
    }

    private void ClearSelection() => selectedDeviceIds.Clear();

    private async Task BulkScreenshot()
    {
        if (selectedDeviceIds.Count == 0)
        {
            return;
        }

        isBulkScreenshotting = true;
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            List<Device> targetDevices = await context.Devices
                .Where(d => selectedDeviceIds.Contains(d.DeviceId) && !string.IsNullOrEmpty(d.CallbackUrl))
                .ToListAsync();

            HttpClient client = HttpClientFactory.CreateClient("player");
            List<Task<HttpResponseMessage>> tasks = targetDevices
                .Select(d => client.PostAsync($"{d.CallbackUrl}/screenshot", null))
                .ToList();
            await Task.WhenAll(tasks);

            bulkResultMessage = $"Screenshot requested for {targetDevices.Count} online device(s).";
            bulkResultIsSuccess = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error requesting bulk screenshot");
            bulkResultMessage = "Error requesting bulk screenshot.";
            bulkResultIsSuccess = false;
        }
        finally
        {
            isBulkScreenshotting = false;
            StateHasChanged();
        }
    }

    private async Task BulkMoveGroup()
    {
        if (selectedDeviceIds.Count == 0 || string.IsNullOrEmpty(bulkGroupSelection))
        {
            return;
        }

        isBulkMovingGroup = true;
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            List<Device> targetDevices = await context.Devices
                .Where(d => selectedDeviceIds.Contains(d.DeviceId))
                .ToListAsync();

            foreach (Device d in targetDevices)
            {
                d.Group = bulkGroupSelection;
            }
            await context.SaveChangesAsync();

            bulkResultMessage = $"Moved {targetDevices.Count} device(s) to group '{bulkGroupSelection}'.";
            bulkResultIsSuccess = true;
            bulkGroupSelection = null;
            selectedDeviceIds.Clear();
            await LoadDevices();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error moving devices to group");
            bulkResultMessage = "Error moving devices to group.";
            bulkResultIsSuccess = false;
        }
        finally
        {
            isBulkMovingGroup = false;
            StateHasChanged();
        }
    }

    private async Task BulkAssignVersion()
    {
        if (string.IsNullOrEmpty(bulkVersionGroup) || string.IsNullOrEmpty(bulkVersionSelection))
        {
            return;
        }

        isBulkAssigningVersion = true;
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            DeviceGroupVersion? groupVersion = await context.DeviceGroupVersions
                .FirstOrDefaultAsync(gv => gv.GroupName == bulkVersionGroup);

            if (groupVersion == null)
            {
                groupVersion = new DeviceGroupVersion
                {
                    GroupName = bulkVersionGroup,
                    TargetVersion = bulkVersionSelection
                };
                context.DeviceGroupVersions.Add(groupVersion);
            }
            else
            {
                groupVersion.TargetVersion = bulkVersionSelection;
            }

            await context.SaveChangesAsync();

            bulkResultMessage = $"Assigned version '{bulkVersionSelection}' to group '{bulkVersionGroup}'.";
            bulkResultIsSuccess = true;
            bulkVersionGroup = null;
            bulkVersionSelection = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error assigning version to group");
            bulkResultMessage = "Error assigning version to group.";
            bulkResultIsSuccess = false;
        }
        finally
        {
            isBulkAssigningVersion = false;
            StateHasChanged();
        }
    }

    private void DismissBulkResult() => bulkResultMessage = null;

    private async Task ShowScreenshotHistory(Device device)
    {
        historyDevice = device;
        screenshotHistory = null;
        selectedScreenshot = null;
        previewCacheBust = DateTime.UtcNow.Ticks.ToString();
        StateHasChanged();

        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            screenshotHistory = await context.DeviceScreenshots
                .Where(s => s.DeviceId == device.Id)
                .OrderByDescending(s => s.CapturedAt)
                .Select(s => new DeviceScreenshotDto
                {
                    Id = s.Id,
                    CapturedAt = s.CapturedAt,
                    Url = $"/api/media/screenshot/{device.DeviceId}/{Path.GetFileName(s.FilePath)}"
                })
                .ToListAsync();
            if (screenshotHistory.Count > 0) selectedScreenshot = screenshotHistory[0];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading screenshot history for device {DeviceId}", device.DeviceId);
            screenshotHistory = [];
        }

        StateHasChanged();
    }

    private void SelectScreenshot(DeviceScreenshotDto shot)
    {
        selectedScreenshot = shot;
        previewCacheBust = DateTime.UtcNow.Ticks.ToString();
    }

    private void CloseHistory()
    {
        historyDevice = null;
        screenshotHistory = null;
        selectedScreenshot = null;
    }

    private async Task DeleteScreenshot(DeviceScreenshotDto shot)
    {
        if (historyDevice == null) return;

        isDeletingScreenshot = true;
        try
        {
            await using PlainSightDbContext context = await DbFactory.CreateDbContextAsync();
            DeviceScreenshot? entity = await context.DeviceScreenshots.FindAsync(shot.Id);
            if (entity != null)
            {
                try
                {
                    if (File.Exists(entity.FilePath))
                    {
                        File.Delete(entity.FilePath);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to delete screenshot file {Path}", entity.FilePath);
                }

                context.DeviceScreenshots.Remove(entity);

                // Update device record if this was the latest
                Device? device = await context.Devices.FirstOrDefaultAsync(d => d.Id == historyDevice.Id);
                if (device != null && device.LatestScreenshotPath == entity.FilePath)
                {
                    device.LatestScreenshotPath = null;
                    device.LatestScreenshotAt = null;
                }

                await context.SaveChangesAsync();
                Logger.LogInformation("Screenshot {Id} deleted directly", shot.Id);

                // Refresh history and main list
                await ShowScreenshotHistory(historyDevice);
                await LoadDevices();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting screenshot {Id} directly", shot.Id);
        }
        finally
        {
            isDeletingScreenshot = false;
            StateHasChanged();
        }
    }

    private void HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseHistory();
    }

    private static bool IsDeviceOnline(DateTime lastSeen) => (DateTime.UtcNow - lastSeen).TotalSeconds < 60;

    private static string GetTimeSince(DateTime dateTime)
    {
        TimeSpan timeSpan = DateTime.UtcNow - dateTime;
        if (timeSpan.TotalSeconds < 60)
        {
            
            return $"{(int)timeSpan.TotalSeconds}s ago";
        }

        if (timeSpan.TotalMinutes < 60)
        {
            
            return $"{(int)timeSpan.TotalMinutes}m ago";
        }

        return timeSpan.TotalHours < 24 ? $"{(int)timeSpan.TotalHours}h ago" : $"{(int)timeSpan.TotalDays}d ago";
    }

    public void Dispose() => refreshTimer?.Dispose();
}
