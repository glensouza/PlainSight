@page "/devices"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ILogger<Devices> Logger

<PageTitle>Devices — PlainSight</PageTitle>

<div class="page-header">
    <h1>Devices</h1>
    <p class="text-muted mb-0">Monitor and manage your digital signage fleet</p>
</div>

@if (devices == null)
{
    <p><em>Loading devices...</em></p>
}
else if (!devices.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No devices registered yet. Devices will appear here once they send their first heartbeat.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Device ID</th>
                    <th>Name</th>
                    <th>Group</th>
                    <th>Last Seen</th>
                    <th>Version</th>
                    <th>Currently Playing</th>
                    <th>Screenshot</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Device device in devices)
                {
                    bool isOnline = IsDeviceOnline(device.LastSeen);
                    <tr class="@(isOnline ? "" : "table-secondary")">
                        <td>
                            @if (isOnline)
                            {
                                <span class="badge bg-success" title="Online">
                                    <i class="bi bi-circle-fill"></i> Online
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger" title="Offline">
                                    <i class="bi bi-circle-fill"></i> Offline
                                </span>
                            }
                        </td>
                        <td><code>@device.DeviceId</code></td>
                        <td>@device.Name</td>
                        <td><span class="badge bg-primary">@device.Group</span></td>
                        <td>
                            <span title="@device.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")">
                                @GetTimeSince(device.LastSeen)
                            </span>
                        </td>
                        <td><code>@device.CurrentVersion</code></td>
                        <td>@(device.CurrentlyPlaying ?? "-")</td>
                        <td>
                            @if (device.LatestScreenshotAt.HasValue)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShowScreenshot(device)"
                                        title="@device.LatestScreenshotAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                    <i class="bi bi-image"></i>
                                    <span>@GetTimeSince(device.LatestScreenshotAt.Value)</span>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => RequestScreenshot(device.DeviceId)"
                                    disabled="@(!isOnline || requestingScreenshot.Contains(device.DeviceId))">
                                @if (requestingScreenshot.Contains(device.DeviceId))
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Requesting...</span>
                                }
                                else
                                {
                                    <i class="bi bi-camera"></i>
                                    <span>Screenshot</span>
                                }
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="LoadDevices">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
        <span class="ms-2 text-muted">Auto-refreshing every 5 seconds</span>
    </div>
}

@if (previewDevice != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);" @onclick="ClosePreview">
        <div class="modal-dialog modal-xl modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Screenshot — <code>@previewDevice.DeviceId</code>
                        @if (previewDevice.LatestScreenshotAt.HasValue)
                        {
                            <span class="ms-2 text-muted small">@previewDevice.LatestScreenshotAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body text-center p-2">
                    <img src="/api/device/@previewDevice.DeviceId/screenshot?t=@previewCacheBust"
                         alt="Latest screenshot for @previewDevice.DeviceId"
                         class="img-fluid rounded"
                         style="max-height:75vh;" />
                </div>
            </div>
        </div>
    </div>
}

@using PlainSight.Shared.Models
@implements IDisposable

@code {
    private List<Device>? devices;
    private HashSet<string> requestingScreenshot = new();
    private Timer? refreshTimer;
    private HttpClient? httpClient;
    private Device? previewDevice;
    private string previewCacheBust = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        httpClient = HttpClientFactory.CreateClient();
        httpClient.BaseAddress = new Uri(Navigation.BaseUri);

        await LoadDevices();

        refreshTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadDevices();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadDevices()
    {
        try
        {
            devices = await httpClient!.GetFromJsonAsync<List<Device>>("/api/device");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading devices");
            devices = new List<Device>();
        }
    }

    private async Task RequestScreenshot(string deviceId)
    {
        requestingScreenshot.Add(deviceId);
        try
        {
            HttpResponseMessage response = await httpClient!.PostAsync($"/api/device/{deviceId}/screenshot", null);
            if (response.IsSuccessStatusCode)
                Logger.LogInformation("Screenshot requested for device {DeviceId}", deviceId);
            else
                Logger.LogWarning("Failed to request screenshot for device {DeviceId}", deviceId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error requesting screenshot for device {DeviceId}", deviceId);
        }
        finally
        {
            requestingScreenshot.Remove(deviceId);
            StateHasChanged();
        }
    }

    private void ShowScreenshot(Device device)
    {
        previewDevice = device;
        previewCacheBust = DateTime.UtcNow.Ticks.ToString();
    }

    private void ClosePreview()
    {
        previewDevice = null;
    }

    private bool IsDeviceOnline(DateTime lastSeen)
    {
        return (DateTime.UtcNow - lastSeen).TotalSeconds < 60;
    }

    private string GetTimeSince(DateTime dateTime)
    {
        TimeSpan timeSpan = DateTime.UtcNow - dateTime;

        if (timeSpan.TotalSeconds < 60)
            return $"{(int)timeSpan.TotalSeconds}s ago";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";

        return $"{(int)timeSpan.TotalDays}d ago";
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
