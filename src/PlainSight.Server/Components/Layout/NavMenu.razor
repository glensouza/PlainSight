@inject PlainSight.Server.Services.VersionService VersionService

<div class="sidebar-shell">
    <div class="sidebar-brand">
        <div class="sidebar-brand-mark">
            <img src="favicon.svg" width="22" height="22" alt="PlainSight Logo" />
        </div>
        <div>
            <div class="sidebar-brand-name">PlainSight</div>
            <div class="sidebar-brand-sub">
                <a href="@VersionService.GetCommitUrl()" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-inherit">
                    @VersionService.GetServerVersion()
                </a>
            </div>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <nav class="nav-scrollable">
        <div class="nav-section-label">Operations</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill"></i> Mission Control
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="devices">
                <i class="bi bi-cpu"></i> Devices
            </NavLink>
        </div>

        <div class="nav-section-label">Library</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="content">
                <i class="bi bi-images"></i> Content Library
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="idle-content">
                <i class="bi bi-clock-history"></i> Idle Library
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="playlists">
                <i class="bi bi-collection-play"></i> Playlists
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="announcements">
                <i class="bi bi-megaphone"></i> Announcements
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="schedules">
                <i class="bi bi-calendar-event"></i> Schedules
            </NavLink>
        </div>

        <div class="nav-section-label">Live</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="ndi">
                <i class="bi bi-broadcast"></i> NDI Sources
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-section-label">System</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="logs">
                        <i class="bi bi-journal-text"></i> System Logs
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="versions">
                        <i class="bi bi-box-seam"></i> Software Versions
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="branding">
                        <i class="bi bi-patch-check"></i> Branding
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="users">
                        <i class="bi bi-people"></i> Manage Users
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-spacer"></div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-footer">
                    <div class="nav-user-info">
                        <i class="bi bi-person-circle"></i>
                        <span>@context.User.Identity?.Name</span>
                    </div>
                    <form action="auth/logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-signout">
                            <i class="bi bi-box-arrow-right"></i> Sign Out
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>
