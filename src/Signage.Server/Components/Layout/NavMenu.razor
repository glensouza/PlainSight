<div class="sidebar-brand">
    <i class="bi bi-display-fill sidebar-brand-icon"></i>
    <div>
        <div class="sidebar-brand-name">PlainSight</div>
        <div class="sidebar-brand-sub">Digital Signage</div>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-section-label">Dashboard</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill"></i> Overview
            </NavLink>
        </div>

        <div class="nav-section-label">Manage</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="devices">
                <i class="bi bi-display"></i> Devices
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="content">
                <i class="bi bi-film"></i> Content
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="playlists">
                <i class="bi bi-collection-play"></i> Playlists
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="versions">
                <i class="bi bi-box-seam"></i> Versions
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-section-label">Admin</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="users">
                        <i class="bi bi-people-fill"></i> Users
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item mt-auto">
                    <span class="nav-link text-muted small">
                        <i class="bi bi-person-circle"></i> @context.User.Identity?.Name
                    </span>
                </div>
                <div class="nav-item">
                    <form action="/auth/logout" method="post">
                        <button type="submit" class="nav-link btn btn-link w-100 text-start text-danger">
                            <i class="bi bi-box-arrow-right"></i> Sign Out
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>
