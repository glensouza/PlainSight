@page "/users"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Signage.Server.Data
@inject SignageDbContext DbContext
@inject ILogger<Users> Logger

<PageTitle>Users — PlainSight</PageTitle>

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>User Management</h1>
        <p class="text-muted mb-0">Manage administrator accounts</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowAddForm">
        <i class="bi bi-person-plus-fill"></i> Add User
    </button>
</div>

@if (!string.IsNullOrEmpty(globalError))
{
    <div class="alert alert-danger alert-dismissible">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @globalError
        <button type="button" class="btn-close" @onclick="() => globalError = null"></button>
    </div>
}

@if (showAddForm)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-person-plus-fill me-1"></i> New User
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Username</label>
                    <input type="text" class="form-control @(addErrors.ContainsKey("username") ? "is-invalid" : "")"
                           @bind="addUsername" @bind:event="oninput" maxlength="50" />
                    @if (addErrors.TryGetValue("username", out string? uErr))
                    {
                        <div class="invalid-feedback">@uErr</div>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" class="form-control @(addErrors.ContainsKey("password") ? "is-invalid" : "")"
                           @bind="addPassword" @bind:event="oninput" />
                    @if (addErrors.TryGetValue("password", out string? pErr))
                    {
                        <div class="invalid-feedback">@pErr</div>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Confirm Password</label>
                    <input type="password" class="form-control @(addErrors.ContainsKey("confirm") ? "is-invalid" : "")"
                           @bind="addPasswordConfirm" @bind:event="oninput" />
                    @if (addErrors.TryGetValue("confirm", out string? cErr))
                    {
                        <div class="invalid-feedback">@cErr</div>
                    }
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success" @onclick="AddUserAsync" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Save
                </button>
                <button class="btn btn-secondary ms-2" @onclick="CancelAdd">Cancel</button>
            </div>
        </div>
    </div>
}

@if (users is null)
{
    <p><em>Loading users...</em></p>
}
else if (users.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i> No users found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Last Login</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (AdminUser user in users)
                {
                    <tr>
                        <td><strong>@user.Username</strong></td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success"><i class="bi bi-circle-fill me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-circle me-1"></i>Inactive</span>
                            }
                        </td>
                        <td title="@user.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                            @user.CreatedAt.ToString("yyyy-MM-dd")
                        </td>
                        <td>
                            @(user.LastLoginAt.HasValue
                                ? user.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm") + " UTC"
                                : "Never")
                        </td>
                        <td>
                            @if (editingPasswordUserId == user.Id)
                            {
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <input type="password" class="form-control form-control-sm @(pwErrors.ContainsKey("new") ? "is-invalid" : "")"
                                           placeholder="New password" @bind="editPassword" style="width:160px" />
                                    <input type="password" class="form-control form-control-sm @(pwErrors.ContainsKey("confirm") ? "is-invalid" : "")"
                                           placeholder="Confirm" @bind="editPasswordConfirm" style="width:130px" />
                                    <button class="btn btn-sm btn-success" @onclick="() => SavePasswordAsync(user.Id)" disabled="@saving">Save</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="CancelEditPassword">Cancel</button>
                                </div>
                                @if (pwErrors.Count > 0)
                                {
                                    <div class="text-danger small mt-1">@string.Join(" ", pwErrors.Values)</div>
                                }
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => StartEditPassword(user.Id)"
                                        title="Change password">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success") me-1"
                                        @onclick="() => ToggleActiveAsync(user)"
                                        title="@(user.IsActive ? "Deactivate" : "Activate")"
                                        disabled="@(saving || (user.IsActive && activeCount <= 1))">
                                    <i class="bi @(user.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ConfirmDelete(user)"
                                        title="Delete user"
                                        disabled="@(saving || users.Count <= 1)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (deleteTarget is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete User</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@deleteTarget.Username</strong>? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="DeleteUserAsync" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Delete
                    </button>
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AdminUser>? users;
    private int activeCount;
    private bool saving;
    private string? globalError;

    // Add form state
    private bool showAddForm;
    private string addUsername = string.Empty;
    private string addPassword = string.Empty;
    private string addPasswordConfirm = string.Empty;
    private Dictionary<string, string> addErrors = new();

    // Change password state
    private int? editingPasswordUserId;
    private string editPassword = string.Empty;
    private string editPasswordConfirm = string.Empty;
    private Dictionary<string, string> pwErrors = new();

    // Delete state
    private AdminUser? deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await DbContext.AdminUsers
            .AsNoTracking()
            .OrderBy(u => u.Username)
            .ToListAsync();
        activeCount = users.Count(u => u.IsActive);
    }

    private void ShowAddForm()
    {
        addUsername = string.Empty;
        addPassword = string.Empty;
        addPasswordConfirm = string.Empty;
        addErrors = new();
        showAddForm = true;
    }

    private void CancelAdd()
    {
        showAddForm = false;
        addErrors = new();
    }

    private async Task AddUserAsync()
    {
        addErrors = new();

        if (string.IsNullOrWhiteSpace(addUsername))
            addErrors["username"] = "Username is required.";
        else if (addUsername.Length < 2)
            addErrors["username"] = "Username must be at least 2 characters.";

        if (string.IsNullOrWhiteSpace(addPassword))
            addErrors["password"] = "Password is required.";
        else if (addPassword.Length < 6)
            addErrors["password"] = "Password must be at least 6 characters.";

        if (addPassword != addPasswordConfirm)
            addErrors["confirm"] = "Passwords do not match.";

        if (addErrors.Count > 0)
            return;

        bool exists = await DbContext.AdminUsers.AnyAsync(u => u.Username == addUsername.Trim());
        if (exists)
        {
            addErrors["username"] = "Username already exists.";
            return;
        }

        saving = true;
        try
        {
            DbContext.AdminUsers.Add(new AdminUser
            {
                Username = addUsername.Trim(),
                PasswordHash = BCrypt.Net.BCrypt.HashPassword(addPassword),
                IsActive = true,
                CreatedAt = DateTime.UtcNow
            });
            await DbContext.SaveChangesAsync();
            showAddForm = false;
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding user {Username}", addUsername);
            globalError = "Failed to add user.";
        }
        finally
        {
            saving = false;
        }
    }

    private void StartEditPassword(int userId)
    {
        editingPasswordUserId = userId;
        editPassword = string.Empty;
        editPasswordConfirm = string.Empty;
        pwErrors = new();
    }

    private void CancelEditPassword()
    {
        editingPasswordUserId = null;
        pwErrors = new();
    }

    private async Task SavePasswordAsync(int userId)
    {
        pwErrors = new();

        if (string.IsNullOrWhiteSpace(editPassword))
            pwErrors["new"] = "Password is required.";
        else if (editPassword.Length < 6)
            pwErrors["new"] = "Password must be at least 6 characters.";

        if (editPassword != editPasswordConfirm)
            pwErrors["confirm"] = "Passwords do not match.";

        if (pwErrors.Count > 0)
            return;

        saving = true;
        try
        {
            AdminUser? user = await DbContext.AdminUsers.FindAsync(userId);
            if (user is null)
            {
                globalError = "User not found.";
                return;
            }
            user.PasswordHash = BCrypt.Net.BCrypt.HashPassword(editPassword);
            await DbContext.SaveChangesAsync();
            editingPasswordUserId = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing password for user {UserId}", userId);
            globalError = "Failed to change password.";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleActiveAsync(AdminUser user)
    {
        if (user.IsActive && activeCount <= 1)
        {
            globalError = "Cannot deactivate the last active admin.";
            return;
        }

        saving = true;
        try
        {
            AdminUser? entity = await DbContext.AdminUsers.FindAsync(user.Id);
            if (entity is null)
                return;
            entity.IsActive = !entity.IsActive;
            await DbContext.SaveChangesAsync();
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling active status for user {UserId}", user.Id);
            globalError = "Failed to update user.";
        }
        finally
        {
            saving = false;
        }
    }

    private void ConfirmDelete(AdminUser user)
    {
        deleteTarget = user;
        globalError = null;
    }

    private void CancelDelete()
    {
        deleteTarget = null;
    }

    private async Task DeleteUserAsync()
    {
        if (deleteTarget is null)
            return;

        if (users!.Count <= 1)
        {
            globalError = "Cannot delete the only admin user.";
            deleteTarget = null;
            return;
        }

        saving = true;
        try
        {
            AdminUser? entity = await DbContext.AdminUsers.FindAsync(deleteTarget.Id);
            if (entity is not null)
            {
                DbContext.AdminUsers.Remove(entity);
                await DbContext.SaveChangesAsync();
            }
            deleteTarget = null;
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting user {UserId}", deleteTarget?.Id);
            globalError = "Failed to delete user.";
        }
        finally
        {
            saving = false;
        }
    }
}
