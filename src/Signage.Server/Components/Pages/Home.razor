@page "/"

<PageTitle>PlainSight - Digital Signage</PageTitle>

<h1>PlainSight Digital Signage System</h1>

<p class="lead">Enterprise-grade distributed digital signage network with zero-touch maintenance</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-display"></i> Device Dashboard
                </h5>
                <p class="card-text">Monitor your fleet of digital signage players in real-time. View device status, versions, and currently playing content.</p>
                <a href="/devices" class="btn btn-primary">Go to Devices</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-file-earmark-play"></i> Content Library
                </h5>
                <p class="card-text">Upload videos and images, or render websites to video for display on your digital signage.</p>
                <a href="/content" class="btn btn-primary">Manage Content</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-collection-play"></i> Playlists
                </h5>
                <p class="card-text">Create and schedule playlists to organize and control what content plays on your devices.</p>
                <a href="/playlists" class="btn btn-primary">Manage Playlists</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-box-seam"></i> Version Management
                </h5>
                <p class="card-text">Manage player software versions and perform canary deployments to device groups.</p>
                <a href="/versions" class="btn btn-primary">Manage Versions</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-info-circle"></i> System Features
                </h5>
                <ul class="list-unstyled">
                    <li><i class="bi bi-check-circle text-success"></i> Zero-sync SMB streaming</li>
                    <li><i class="bi bi-check-circle text-success"></i> Self-updating players</li>
                    <li><i class="bi bi-check-circle text-success"></i> Live screenshots</li>
                    <li><i class="bi bi-check-circle text-success"></i> Canary deployments</li>
                    <li><i class="bi bi-check-circle text-success"></i> Content scheduling</li>
                    <li><i class="bi bi-check-circle text-success"></i> Website rendering</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <div class="alert alert-info">
        <h5><i class="bi bi-lightbulb"></i> Quick Start</h5>
        <ol class="mb-0">
            <li>Go to <a href="/content" class="alert-link">Content</a> to upload videos or render websites</li>
            <li>Create a <a href="/playlists" class="alert-link">Playlist</a> to organize your content</li>
            <li>View your digital signage fleet in <a href="/devices" class="alert-link">Devices</a></li>
            <li>Use the screenshot feature to verify player operation</li>
            <li>Manage software updates through <a href="/versions" class="alert-link">Version Management</a></li>
        </ol>
    </div>
</div>
