@page "/content"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ILogger<Content> Logger
@using Signage.Shared.Models
@implements IDisposable

<PageTitle>Content Library — PlainSight</PageTitle>

<div class="page-header">
    <h1>Content Library</h1>
    <p class="text-muted mb-0">Manage media files and rendered content for your digital signage</p>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-cloud-upload"></i> Upload Content</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Upload Video or Image</label>
                            <input class="form-control" type="file" accept="video/*,image/*" @ref="fileInput" />
                            <small class="text-muted">Supported: MP4, AVI, MOV, PNG, JPG</small>
                            <div class="alert alert-warning alert-sm mt-2 mb-0 py-1 px-2">
                                <small><i class="bi bi-exclamation-triangle"></i> File upload UI requires JavaScript interop - use API endpoint directly for now</small>
                            </div>
                        </div>
                        <button class="btn btn-primary" @onclick="UploadFile" disabled="@uploading">
                            @if (uploading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Uploading...</span>
                            }
                            else
                            {
                                <i class="bi bi-upload"></i>
                                <span>Upload File</span>
                            }
                        </button>
                    </div>
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6><i class="bi bi-globe"></i> Render Website to Video</h6>
                                <div class="mb-2">
                                    <input type="text" class="form-control form-control-sm" placeholder="https://example.com" @bind="renderUrl" />
                                </div>
                                <div class="mb-2">
                                    <input type="number" class="form-control form-control-sm" placeholder="Duration (seconds)" @bind="renderDuration" min="5" max="300" />
                                </div>
                                <button class="btn btn-sm btn-outline-primary" @onclick="RenderWebsite" disabled="@rendering">
                                    @if (rendering)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Rendering...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-camera-video"></i>
                                        <span>Render to Video</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (contentItems == null)
{
    <p><em>Loading content library...</em></p>
}
else if (!contentItems.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No content uploaded yet. Upload videos or images, or render websites to get started.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Name</th>
                    <th>File Name</th>
                    <th>Duration</th>
                    <th>Size</th>
                    <th>Uploaded</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ContentItem item in contentItems)
                {
                    <tr>
                        <td>
                            @if (item.Type == ContentType.Video)
                            {
                                <span class="badge bg-primary"><i class="bi bi-play-circle"></i> Video</span>
                            }
                            else if (item.Type == ContentType.Image)
                            {
                                <span class="badge bg-success"><i class="bi bi-image"></i> Image</span>
                            }
                            else
                            {
                                <span class="badge bg-info"><i class="bi bi-globe"></i> Rendered</span>
                            }
                        </td>
                        <td>@item.Name</td>
                        <td><code>@item.FileName</code></td>
                        <td>@item.DurationSeconds s</td>
                        <td>@FormatFileSize(item.FileSizeBytes)</td>
                        <td>@item.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteContent(item.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ContentItem>? contentItems;
    private HttpClient? httpClient;
    private ElementReference fileInput;
    private bool uploading;
    private bool rendering;
    private string renderUrl = "";
    private int renderDuration = 30;

    protected override async Task OnInitializedAsync()
    {
        httpClient = HttpClientFactory.CreateClient();
        httpClient.BaseAddress = new Uri(Navigation.BaseUri);
        await LoadContent();
    }

    private async Task LoadContent()
    {
        try
        {
            contentItems = await httpClient!.GetFromJsonAsync<List<ContentItem>>("/api/content");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading content");
            contentItems = new List<ContentItem>();
        }
    }

    private async Task UploadFile()
    {
        uploading = true;
        try
        {
            // File upload requires JavaScript interop to read file from browser
            // This would be implemented using IJSRuntime to:
            // 1. Read the file as byte array or stream
            // 2. POST to /api/content/upload endpoint
            // 3. Refresh the content list
            Logger.LogWarning("File upload requires JavaScript interop implementation");
            await Task.CompletedTask;
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task RenderWebsite()
    {
        if (string.IsNullOrWhiteSpace(renderUrl))
        {
            Logger.LogWarning("URL is required for rendering");
            return;
        }

        rendering = true;
        try
        {
            HttpResponseMessage response = await httpClient!.PostAsJsonAsync("/api/content/render", new
            {
                Url = renderUrl,
                DurationSeconds = renderDuration
            });

            if (response.IsSuccessStatusCode)
            {
                Logger.LogInformation("Website rendering started: {Url}", renderUrl);
                renderUrl = "";
                renderDuration = 30;
                await LoadContent();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rendering website");
        }
        finally
        {
            rendering = false;
        }
    }

    private async Task DeleteContent(int id)
    {
        try
        {
            HttpResponseMessage response = await httpClient!.DeleteAsync($"/api/content/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadContent();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting content");
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    public void Dispose()
    {
        // Cleanup if needed
    }
}
