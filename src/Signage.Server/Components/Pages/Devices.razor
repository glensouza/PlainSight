@page "/devices"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ILogger<Devices> Logger

<PageTitle>Devices</PageTitle>

<h1>Device Dashboard</h1>

<p class="text-muted">Monitor and manage your digital signage fleet</p>

@if (devices == null)
{
    <p><em>Loading devices...</em></p>
}
else if (!devices.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No devices registered yet. Devices will appear here once they send their first heartbeat.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Device ID</th>
                    <th>Name</th>
                    <th>Group</th>
                    <th>Last Seen</th>
                    <th>Version</th>
                    <th>Currently Playing</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var device in devices)
                {
                    var isOnline = IsDeviceOnline(device.LastSeen);
                    <tr class="@(isOnline ? "" : "table-secondary")">
                        <td>
                            @if (isOnline)
                            {
                                <span class="badge bg-success" title="Online">
                                    <i class="bi bi-circle-fill"></i> Online
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger" title="Offline">
                                    <i class="bi bi-circle-fill"></i> Offline
                                </span>
                            }
                        </td>
                        <td><code>@device.DeviceId</code></td>
                        <td>@device.Name</td>
                        <td><span class="badge bg-primary">@device.Group</span></td>
                        <td>
                            <span title="@device.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")">
                                @GetTimeSince(device.LastSeen)
                            </span>
                        </td>
                        <td><code>@device.CurrentVersion</code></td>
                        <td>@(device.CurrentlyPlaying ?? "-")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" 
                                    @onclick="() => RequestScreenshot(device.DeviceId)"
                                    disabled="@(!isOnline || requestingScreenshot.Contains(device.DeviceId))">
                                @if (requestingScreenshot.Contains(device.DeviceId))
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Requesting...</span>
                                }
                                else
                                {
                                    <i class="bi bi-camera"></i>
                                    <span>Screenshot</span>
                                }
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="mt-3">
        <button class="btn btn-primary" @onclick="LoadDevices">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
        <span class="ms-2 text-muted">Auto-refreshing every 5 seconds</span>
    </div>
}

@implements IDisposable

@code {
    private List<Signage.Shared.Models.Device>? devices;
    private HashSet<string> requestingScreenshot = new();
    private System.Threading.Timer? refreshTimer;
    private HttpClient? httpClient;

    protected override async Task OnInitializedAsync()
    {
        // Create HttpClient with base address
        httpClient = HttpClientFactory.CreateClient();
        httpClient.BaseAddress = new Uri(Navigation.BaseUri);
        
        await LoadDevices();
        
        // Auto-refresh every 5 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadDevices();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadDevices()
    {
        try
        {
            devices = await httpClient!.GetFromJsonAsync<List<Signage.Shared.Models.Device>>("/api/device");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading devices");
            devices = new List<Signage.Shared.Models.Device>();
        }
    }

    private async Task RequestScreenshot(string deviceId)
    {
        requestingScreenshot.Add(deviceId);
        try
        {
            var response = await httpClient!.PostAsync($"/api/device/{deviceId}/screenshot", null);
            if (response.IsSuccessStatusCode)
            {
                Logger.LogInformation("Screenshot requested for device {DeviceId}", deviceId);
            }
            else
            {
                Logger.LogWarning("Failed to request screenshot for device {DeviceId}", deviceId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error requesting screenshot for device {DeviceId}", deviceId);
        }
        finally
        {
            requestingScreenshot.Remove(deviceId);
            StateHasChanged();
        }
    }

    private bool IsDeviceOnline(DateTime lastSeen)
    {
        // Consider device online if seen within last 60 seconds
        return (DateTime.UtcNow - lastSeen).TotalSeconds < 60;
    }

    private string GetTimeSince(DateTime lastSeen)
    {
        var timeSpan = DateTime.UtcNow - lastSeen;
        
        if (timeSpan.TotalSeconds < 60)
            return $"{(int)timeSpan.TotalSeconds}s ago";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        
        return $"{(int)timeSpan.TotalDays}d ago";
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
