# PlainSight Environment Configuration
# Copy this file to .env and set your own secure values

# PostgreSQL Database Password (REQUIRED)
# Use a strong, randomly generated password for production
POSTGRES_PASSWORD=your_secure_password_here

# pgAdmin Default Credentials (REQUIRED for database management UI)
PGADMIN_DEFAULT_EMAIL=admin@coronasda.church
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password

# SMB File Share Credentials (REQUIRED)
# Username for accessing the Samba file share
SMB_USER=your_smb_username

# Password for accessing the Samba file share
# Use a strong, randomly generated password for production
SMB_PASSWORD=your_secure_smb_password

# Cloudflare Tunnel Token (REQUIRED for remote access)
# Obtain this from the Cloudflare Zero Trust Dashboard (Tunnels section)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Example of generating secure passwords:
# On Linux/macOS: openssl rand -base64 32
# On Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
